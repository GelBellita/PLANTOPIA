@* Views/Account/Cart.cshtml *@
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "My Cart";
}

<style>
   .cart-page {
    display: flex;
    flex-direction: column;
    gap: 14px;
    }

    .cart-grid {
        display: grid;
        grid-template-columns: 1fr 240px;
        gap: 14px;
        align-items: start;
    }

    .cart-items-card {
        background: var(--white);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .cart-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        transition: background 0.15s;
    }

    .cart-item:last-child { border-bottom: none; }
    .cart-item:hover { background: var(--green-bg); }

    .cart-item-img {
        width: 58px;
        height: 58px;
        border-radius: var(--radius-md);
        object-fit: cover;
        background: var(--green-pale);
        flex-shrink: 0;
    }

    .cart-item-info { flex: 1; }

    .cart-item-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-dark);
    }

    .cart-item-price {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 3px;
    }

    .cart-qty-controls {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .cart-qty-btn {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        border: 1.5px solid var(--border);
        background: var(--white);
        font-size: 14px;
        color: var(--text-mid);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: border-color 0.15s, background 0.15s;
        font-family: var(--font-ui);
        line-height: 1;
    }

    .cart-qty-btn:hover {
        border-color: var(--green-soft);
        background: var(--green-pale);
        color: var(--green-mid);
    }

    .cart-qty-num {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-dark);
        min-width: 14px;
        text-align: center;
    }

    .cart-delete-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        padding: 4px;
        border-radius: var(--radius-sm);
        transition: color 0.15s, background 0.15s;
        margin-left: 4px;
    }

    .cart-delete-btn:hover {
        color: var(--red);
        background: var(--red-bg);
    }

    .cart-footer {
        padding: 10px 16px;
        border-top: 1px solid var(--border);
        background: var(--white);
        border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    }

    .btn-continue-shopping {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 500;
        color: var(--text-mid);
        text-decoration: none;
        transition: color 0.15s;
    }

    .btn-continue-shopping:hover { color: var(--green-mid); }

    .order-summary-card {
        background: var(--white);
        border-radius: var(--radius-lg);
        padding: 16px;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .order-summary-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 2px;
    }

    .order-summary-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        color: var(--text-mid);
    }

    .order-summary-row.discount { color: #c0392b; }

    .order-summary-row-label {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .order-summary-divider {
        height: 1px;
        background: var(--border);
        margin: 2px 0;
    }

    .order-total-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .order-total-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-dark);
    }

    .order-total-amount {
        font-size: 15px;
        font-weight: 800;
        color: var(--green-dark);
    }

    .free-shipping-banner {
        background: var(--green-pale);
        border-radius: var(--radius-sm);
        padding: 8px 10px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    .free-shipping-icon { font-size: 14px; flex-shrink: 0; }

    .free-shipping-text {
        font-size: 11px;
        color: var(--text-mid);
        flex: 1;
    }

    .free-shipping-text strong { color: var(--green-dark); }

    .free-shipping-bar {
        height: 4px;
        background: var(--border);
        border-radius: 10px;
        margin-top: 6px;
        overflow: hidden;
    }

    .free-shipping-fill {
        height: 100%;
        width: 55%;
        background: var(--green-mid);
        border-radius: 10px;
    }

    .btn-checkout {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        padding: 10px;
        background: var(--green-dark);
        color: var(--white);
        border: none;
        border-radius: var(--radius-sm);
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s;
        font-family: var(--font-ui);
        text-decoration: none;
    }

    .btn-checkout:hover {
        background: var(--green-mid);
        color: var(--white);
    }

    .payment-methods {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .payment-label {
        font-size: 11px;
        color: var(--text-muted);
    }

    .payment-icons {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .payment-chip {
        padding: 4px 9px;
        border: 1.5px solid var(--border);
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        color: var(--text-mid);
        background: var(--white);
    }

    .payment-chip.visa   { color: #1a1f71; }
    .payment-chip.master { color: #eb001b; }
    .payment-chip.gcash  { color: #0070ff; }
    .payment-chip.paypal { color: #003087; }
</style>

<div class="profile-page-wrapper">
<div class="cart-page">

    @* Header *@
    <div class="profile-header">
        <h1 class="profile-title">My Cart <span class="profile-title-emoji">🌿</span></h1>
        <p class="profile-subtitle">Review the items you've added before checkout.</p>
    </div>

    <div class="cart-grid">

        @* LEFT — Cart Items *@
        <div>
            <div class="cart-items-card">

                @* Item 1 *@
                <div class="cart-item">
                    <img class="cart-item-img"
                         src="~/images/fiddle-leaf.png" alt="Fiddle Leaf Fig"
                         onerror="this.src='https://placehold.co/80x80/eef4eb/4a7c4a?text=🌿'" />
                    <div class="cart-item-info">
                        <div class="cart-item-name">Fiddle Leaf Fig</div>
                        <div class="cart-item-price">₱899.00</div>
                    </div>
                    <div class="cart-qty-controls">
                        <button class="cart-qty-btn">−</button>
                        <span class="cart-qty-num">1</span>
                        <button class="cart-qty-btn">+</button>
                    </div>
                    <button class="cart-delete-btn" title="Remove item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                            <path d="M10 11v6M14 11v6"/>
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                        </svg>
                    </button>
                </div>

                @* Item 2 *@
                <div class="cart-item">
                    <img class="cart-item-img"
                         src="~/images/snake-plant.png" alt="Snake Plant"
                         onerror="this.src='https://placehold.co/80x80/eef4eb/4a7c4a?text=🪴'" />
                    <div class="cart-item-info">
                        <div class="cart-item-name">Snake Plant</div>
                        <div class="cart-item-price">₱499.00</div>
                    </div>
                    <div class="cart-qty-controls">
                        <button class="cart-qty-btn">−</button>
                        <span class="cart-qty-num">2</span>
                        <button class="cart-qty-btn">+</button>
                    </div>
                    <button class="cart-delete-btn" title="Remove item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                            <path d="M10 11v6M14 11v6"/>
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                        </svg>
                    </button>
                </div>

                @* Item 3 *@
                <div class="cart-item">
                    <img class="cart-item-img"
                         src="~/images/monstera.png" alt="Monstera Deliciosa"
                         onerror="this.src='https://placehold.co/80x80/eef4eb/4a7c4a?text=🌱'" />
                    <div class="cart-item-info">
                        <div class="cart-item-name">Monstera Deliciosa</div>
                        <div class="cart-item-price">₱1,299.00</div>
                    </div>
                    <div class="cart-qty-controls">
                        <button class="cart-qty-btn">−</button>
                        <span class="cart-qty-num">1</span>
                        <button class="cart-qty-btn">+</button>
                    </div>
                    <button class="cart-delete-btn" title="Remove item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                            <path d="M10 11v6M14 11v6"/>
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                        </svg>
                    </button>
                </div>

                @* Item 4 *@
                <div class="cart-item">
                    <img class="cart-item-img"
                         src="~/images/terracotta-pot.png" alt="Terracotta Pot"
                         onerror="this.src='https://placehold.co/80x80/eef4eb/4a7c4a?text=🪣'" />
                    <div class="cart-item-info">
                        <div class="cart-item-name">Terracotta Pot (Medium)</div>
                        <div class="cart-item-price">₱199.00</div>
                    </div>
                    <div class="cart-qty-controls">
                        <button class="cart-qty-btn">−</button>
                        <span class="cart-qty-num">1</span>
                        <button class="cart-qty-btn">+</button>
                    </div>
                    <button class="cart-delete-btn" title="Remove item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                            <path d="M10 11v6M14 11v6"/>
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                        </svg>
                    </button>
                </div>

            </div>

            @* Continue Shopping *@
            <div style="margin-top: 16px;">
                <a asp-controller="Store" asp-action="Index" class="btn-continue-shopping">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"/>
                        <polyline points="12 19 5 12 12 5"/>
                    </svg>
                    Continue Shopping
                </a>
            </div>
        </div>

        @* RIGHT — Order Summary *@
        <div class="order-summary-card">
            <div class="order-summary-title">Order Summary</div>

            <div class="order-summary-row">
                <span>Subtotal (4 items)</span>
                <span>₱3,395.00</span>
            </div>

            <div class="order-summary-row">
                <span class="order-summary-row-label">
                    Shipping Fee
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                </span>
                <span>₱150.00</span>
            </div>

            <div class="order-summary-row discount">
                <span>Discount</span>
                <span>-₱200.00</span>
            </div>

            <div class="order-summary-divider"></div>

            <div class="order-total-row">
                <span class="order-total-label">Total</span>
                <span class="order-total-amount">₱3,345.00</span>
            </div>

            @* Free Shipping Progress *@
            <div class="free-shipping-banner">
                <div class="free-shipping-icon">🌿</div>
                <div class="free-shipping-text">
                    You're <strong>₱655.00</strong> away from <strong>FREE shipping!</strong>
                    <div class="free-shipping-bar">
                        <div class="free-shipping-fill"></div>
                    </div>
                </div>
            </div>

            @* Checkout Button *@
            <a asp-controller="Store" asp-action="Checkout" class="btn-checkout">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                Proceed to Checkout
            </a>

            @* Payment Methods *@
            <div class="payment-methods">
                <div class="payment-label">We accept:</div>
                <div class="payment-icons">
                    <div class="payment-chip gcash">GCash</div>
                </div>
            </div>
        </div>

    </div>
</div>
</div>
