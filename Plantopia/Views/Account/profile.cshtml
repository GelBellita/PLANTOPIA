@model Plantopia.Models.User

@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "My Profile";

    @* ── Razor expression — get initials ── *@
    var initials = string.IsNullOrEmpty(Model.FullName) ? "?" :
        string.Join("", Model.FullName.Split(' ')
        .Where(w => w.Length > 0)
        .Select(w => w[0]))
        .ToUpper();
}
<div class="sagad-wrapper">
    <div class="profile-page-wrapper">
        <div class="profile-page">

        <div class="profile-header">
            <h1 class="profile-title">My Profile</h1>
            <p class="profile-subtitle">Here's your info! You can update your details anytime.</p>
        </div>

        @* ── TempData success message  ── *@
        @if (TempData["Success"] != null)
        {
            <div class="alert" style="background:#f0f8f0; color:#2d5a27; border-radius:10px; padding:12px 18px; margin-bottom:16px;">
                ✅ @TempData["Success"]
            </div>
        }

        <div class="profile-grid">

            @* LEFT — Profile Information form *@
            <div class="profile-card">
                <h2 class="profile-card-title">Profile Information</h2>

                @* ── Form Tag Helper  ── *@
                <form asp-controller="Account" asp-action="UpdateProfile" method="post" class="profile-form">

                    <div class="form-group-plantopia">
                        <label class="form-label-plantopia">Full Name</label>
                        @* ── Input Tag Helper ── *@
                        <input asp-for="FullName" class="form-input-plantopia" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="form-group-plantopia">
                        <label class="form-label-plantopia">Email</label>
                        @* ── Email readonly — dili pwede i-change ── *@
                        <input asp-for="Email" class="form-input-plantopia" readonly
                               style="background:#f5f5f5; cursor:not-allowed;" />
                    </div>

                    <div class="form-group-plantopia">
                        <label class="form-label-plantopia">Phone Number</label>
                        <input asp-for="Phone" class="form-input-plantopia"
                               placeholder="+63 912 345 6789" />
                    </div>

                    <div class="form-group-plantopia">
                        <label class="form-label-plantopia">Location</label>
                        <input asp-for="Location" class="form-input-plantopia"
                               placeholder="City, Province, Philippines" />
                    </div>

                        <div class="profile-form-footer" style="justify-content:flex-end;">
                            <button type="submit" class="btn-save-changes">Save Changes</button>
                        </div>
                </form>
            </div>

            @* RIGHT — Picture + Quick Links *@
            <div class="profile-right-col">

                    <div class="profile-card profile-picture-card">
                    <h2 class="profile-card-title">Profile Picture</h2>

                    @* Form Tag Helper *@
                    <form asp-controller="Account" asp-action="UploadPhoto"
                          method="post" enctype="multipart/form-data">
                        <div class="profile-picture-area">
                            <div class="profile-picture-wrap">
                                @if (!string.IsNullOrEmpty(Model.ProfilePhoto))
                                {
                                    <img src="@Model.ProfilePhoto" alt="Profile Picture"
                                         class="profile-picture-img" />
                                }
                                else
                                {
                                    <div class="profile-picture-fallback" style="display:flex;">
                                        @initials
                                    </div>
                                }
                                <label for="photoInput" class="profile-picture-camera" title="Change photo">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5">
                                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                                        <circle cx="12" cy="13" r="4" />
                                    </svg>
                                </label>
                            </div>
                            <p class="profile-picture-label">Change your profile picture</p>
                            <input type="file" id="photoInput" name="photo"
                                   accept="image/*" style="display:none;"
                                   onchange="this.form.submit()" />
                            <button type="button" class="btn-upload-photo"
                                    onclick="document.getElementById('photoInput').click()">
                                Upload New Photo
                            </button>
                        </div>
                    </form>
                </div>

                <div class="profile-card">
                    <h2 class="profile-card-title">Quick Links</h2>
                    <div class="quick-links">
                        <a asp-controller="Account" asp-action="ChangePassword" class="quick-link-item">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                            Change Password
                            <svg class="quick-link-arrow" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6" />
                            </svg>
                        </a>
                        <a asp-controller="Account" asp-action="ManageAddresses" class="quick-link-item">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="12" y1="8" x2="12" y2="12" />
                                <line x1="12" y1="16" x2="12.01" y2="16" />
                            </svg>
                            Manage Addresses
                            <svg class="quick-link-arrow" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6" />
                            </svg>
                        </a>
                    </div>
                </div>

            </div>
        </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}