@* Views/Account/Profile.cshtml *@
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "My Profile";
}

<div class="profile-page">

    @* Page Header *@
    <div class="profile-header">
        <h1 class="profile-title">My Profile <span class="profile-title-emoji">🌿</span></h1>
        <p class="profile-subtitle">Here's your info! You can update your details anytime.</p>
    </div>

    <div class="profile-grid">

        @* LEFT — Profile Information form *@
        <div class="profile-card">
            <h2 class="profile-card-title">Profile Information</h2>

            <div class="profile-form">
                <div class="form-group-plantopia">
                    <label class="form-label-plantopia">Full Name</label>
                    <input type="text" class="form-input-plantopia" value="Maria Santos" />
                </div>
                <div class="form-group-plantopia">
                    <label class="form-label-plantopia">Email</label>
                    <input type="email" class="form-input-plantopia" value="maria@email.com" />
                </div>
                <div class="form-group-plantopia">
                    <label class="form-label-plantopia">Phone Number</label>
                    <input type="tel" class="form-input-plantopia" value="+63 912 345 6789" />
                </div>
                <div class="form-group-plantopia">
                    <label class="form-label-plantopia">Location</label>
                    <input type="text" class="form-input-plantopia" value="Cebu City, Cebu, Philippines" />
                </div>

                <div class="profile-form-footer">
                    <button type="button" class="btn-save-changes">Save Changes</button>
                    <div class="profile-form-deco">🌿</div>
                </div>
            </div>
        </div>

        @* RIGHT — Picture + Quick Links *@
        <div class="profile-right-col">

            @* Profile Picture card *@
            <div class="profile-card">
                <h2 class="profile-card-title">Profile Picture</h2>
                <div class="profile-picture-area">
                    <div class="profile-picture-wrap">
                        <img src="~/images/avatar-placeholder.png" alt="Profile Picture"
                             class="profile-picture-img"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="profile-picture-fallback" style="display:none;">MS</div>
                        <button class="profile-picture-camera" title="Change photo">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                                <circle cx="12" cy="13" r="4"/>
                            </svg>
                        </button>
                    </div>
                    <p class="profile-picture-label">Change your profile picture</p>
                    <button type="button" class="btn-upload-photo">Upload New Photo</button>
                </div>
            </div>

            @* Quick Links card *@
            <div class="profile-card">
                <h2 class="profile-card-title">Quick Links</h2>
                <div class="quick-links">
                    <a href="#" class="quick-link-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                        Change Password
                        <svg class="quick-link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </a>
                    <a href="#" class="quick-link-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="8" x2="12" y2="12"/>
                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        Manage Addresses
                        <svg class="quick-link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </a>
                    <a href="#" class="quick-link-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        Order History
                        <svg class="quick-link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </a>
                </div>
            </div>

        </div>
    </div>

    @* Bottom promo banner *@
    <div class="profile-promo-banner">
        <div class="promo-banner-left">
            <div class="promo-banner-icon">🪴<span class="promo-heart">♡</span></div>
            <div class="promo-banner-text">
                <div class="promo-banner-title">Love your plants?</div>
                <div class="promo-banner-sub">Don't forget to check out our new arrivals!</div>
            </div>
        </div>
        <a asp-controller="Store" asp-action="NewArrivals" class="btn-shop-now">Shop Now →</a>
        <div class="promo-banner-deco">🌿🌵🪴</div>
    </div>

</div>
