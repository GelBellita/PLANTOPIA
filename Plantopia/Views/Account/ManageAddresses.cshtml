@model List<Plantopia.Models.Address>

@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "Manage Addresses";
}

@section Styles {
    <link rel="stylesheet" href="~/css/manageaddresses.css" />
}

<div class="profile-page-wrapper">
    <div class="profile-page">

        <div style="margin-bottom:12px;">
            <a asp-controller="Account" asp-action="Profile"
                   style="display:inline-flex; align-items:center; gap:6px; font-size:13px; font-weight:500; color:var(--text-mid); text-decoration:none; padding:7px 16px; border:1.5px solid var(--border); border-radius:20px; background:var(--white); transition:all 0.15s;"
                   onmouseover="this.style.borderColor='var(--green-soft)'; this.style.color='var(--green-mid)'; this.style.background='var(--green-pale)';"
                   onmouseout="this.style.borderColor='var(--border)'; this.style.color='var(--text-mid)'; this.style.background='var(--white)';">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12" />
                    <polyline points="12 19 5 12 12 5" />
                </svg>
                Back
            </a>
        </div>

        <div class="profile-header">
            <h1 class="profile-title">Manage Addresses <span class="profile-title-emoji">📍</span></h1>
            <p class="profile-subtitle">Add and manage your delivery addresses.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert" style="background:#f0f8f0; color:#2d5a27; border-radius:10px; padding:12px 18px; margin-bottom:16px;">
                ✅ @TempData["Success"]
            </div>
        }

        <div class="profile-grid">

            @* LEFT — Add New Address Form *@
            <div class="profile-card">
                <h2 class="profile-card-title">Add New Address</h2>

                <form asp-controller="Account" asp-action="AddAddress" method="post" class="profile-form">

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">

                        <div class="form-group-plantopia">
                            <label class="form-label-plantopia">Label</label>
                            <select name="label" class="form-input-plantopia">
                                <option value="Home">🏠 Home</option>
                                <option value="Work">💼 Work</option>
                                <option value="Other">📦 Other</option>
                            </select>
                        </div>

                        <div class="checkbox-group">
                            <input type="checkbox" name="isDefault" value="true" id="isDefault" />
                            <label for="isDefault">Set as Default Address</label>
                        </div>

                        <div class="form-group-plantopia">
                            <label class="form-label-plantopia">Full Address</label>
                            <input type="text" name="fullAddress" class="form-input-plantopia"
                                   placeholder="House No., Street, Barangay" required />
                        </div>

                        <div class="form-group-plantopia">
                            <label class="form-label-plantopia">City</label>
                            <input type="text" name="city" class="form-input-plantopia"
                                   placeholder="e.g. Cebu City" required />
                        </div>

                        <div class="form-group-plantopia">
                            <label class="form-label-plantopia">Province</label>
                            <input type="text" name="province" class="form-input-plantopia"
                                   placeholder="e.g. Cebu" required />
                        </div>

                        <div class="form-group-plantopia">
                            <label class="form-label-plantopia">ZIP Code</label>
                            <input type="text" name="zipCode" class="form-input-plantopia"
                                   placeholder="e.g. 6000" required />
                        </div>

                    </div>

                    <div style="display:flex; justify-content:flex-end; margin-top:8px;">
                        <button type="submit" class="btn-save-changes">Add Address</button>
                    </div>

                </form>
            </div>

            @* RIGHT — Saved Addresses *@
            <div class="profile-right-col">
                <div class="profile-card">
                    <h2 class="profile-card-title">Saved Addresses</h2>

                    @if (Model == null || Model.Count == 0)
                    {
                        <p style="color:#888; font-size:14px;">No addresses saved yet. Add one! 📍</p>
                    }
                    else
                    {
                        <div class="saved-addresses-list">
                            @foreach (var address in Model)
                            {
                                var bgColor = address.IsDefault ? "#f0f8f0" : "#ffffff";
                                var labelIcon = address.Label == "Home" ? "🏠" : address.Label == "Work" ? "💼" : "📦";

                                <div style="border:1px solid #e8f0e8; border-radius:12px; padding:16px; margin-bottom:14px; background:@bgColor;">

                                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                                        <span style="font-weight:600; color:#2d5a27; font-size:15px;">
                                            @(labelIcon) @(address.Label)
                                        </span>
                                        @if (address.IsDefault)
                                        {
                                            <span style="background:#2d5a27; color:#fff; border-radius:20px; padding:2px 12px; font-size:12px;">
                                                Default
                                            </span>
                                        }
                                    </div>

                                    <p style="margin:0; color:#444; font-size:14px;">@address.FullAddress</p>
                                    <p style="margin:0; color:#666; font-size:13px;">@address.City, @address.Province @address.ZipCode</p>

                                    <div style="display:flex; gap:8px; margin-top:12px;">
                                        @if (!address.IsDefault)
                                        {
                                            <form asp-controller="Account" asp-action="SetDefaultAddress" method="post">
                                                <input type="hidden" name="id" value="@address.Id" />
                                                <button type="submit" style="background:#f0f8f0; color:#2d5a27; border:1px solid #2d5a27; border-radius:8px; padding:6px 14px; font-size:13px; cursor:pointer;">
                                                    Set as Default
                                                </button>
                                            </form>
                                        }
                                        <form asp-controller="Account" asp-action="DeleteAddress" method="post">
                                            <input type="hidden" name="id" value="@address.Id" />
                                            <button type="submit" style="background:#fff0f0; color:#a00; border:1px solid #ffcccc; border-radius:8px; padding:6px 14px; font-size:13px; cursor:pointer;"
                                                    onclick="return confirm('Delete this address?')">
                                                🗑 Delete
                                            </button>
                                        </form>
                                    </div>

                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>