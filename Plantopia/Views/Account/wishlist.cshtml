                        4.8
                    </span>
                </div>
                <div class="wishlist-plant-price">₱350</div>
                <button class="btn-add-to-cart">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1" />
                        <circle cx="20" cy="21" r="1" />
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                    </svg>
                    Add to Cart
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1" />
                        <circle cx="20" cy="21" r="1" />
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                    </svg>
                </button>
                <button class="btn-remove">Remove</button>
            </div>
        </div>

    </div>

    @* Promo Banner *@
    <div class="wishlist-promo">
        <div class="wishlist-promo-left">🪴</div>
        <div class="wishlist-promo-text">
            <div class="wishlist-promo-title">Still looking for your<br>perfect plant?</div>
            <div class="wishlist-promo-sub">Discover more greens that'll brighten up your space.</div>
            <a asp-controller="Store" asp-action="NewArrivals" class="btn-shop-arrivals">
                Shop New Arrivals →
            </a>
        </div>
        <div class="wishlist-promo-right">🌿🌵🪴</div>
    </div>

</div>
