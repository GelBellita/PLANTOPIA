            </div>
            <div class="wishlist-card-body">
                <div class="wishlist-plant-name">Monstera Deliciosa</div>
                <div class="wishlist-plant-meta">
                    <span class="wishlist-plant-shop">By Green Haven PH</span>
                    <span class="wishlist-plant-rating">
                        <svg width="11" height="11" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                        4.9
                    </span>
                </div>
                <div class="wishlist-plant-price">₱850</div>
                <button class="btn-add-to-cart">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1" />
                        <circle cx="20" cy="21" r="1" />
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                    </svg>
                    Add to Cart
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1" />
                        <circle cx="20" cy="21" r="1" />
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                    </svg>
                </button>
                <button class="btn-remove">Remove</button>
            </div>
        </div>

        @* Card 2 *@
        <div class="wishlist-card">
            <div class="wishlist-card-img-wrap">
