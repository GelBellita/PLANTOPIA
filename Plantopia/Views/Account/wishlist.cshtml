@* Views/Account/Wishlist.cshtml *@
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "My Wishlist";
}

<style>
    /* ── Page Header Row ── */
    .wishlist-header-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .wishlist-count {
        font-size: 14px;
        color: var(--text-muted);
        margin-top: 4px;
    }

    .btn-share-wishlist {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 9px 18px;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        background: var(--white);
        font-size: 13.5px;
        font-weight: 500;
        color: var(--text-mid);
        cursor: pointer;
        transition: border-color 0.15s, background 0.15s;
        font-family: var(--font-ui);
        text-decoration: none;
    }

        .btn-share-wishlist:hover {
            border-color: var(--green-soft);
            background: var(--green-pale);
            color: var(--green-mid);
        }

    /* ── Wishlist Grid ── */
    .wishlist-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    /* ── Plant Card ── */
    .wishlist-card {
        background: var(--white);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.15s;
    }

        .wishlist-card:hover {
            box-shadow: var(--shadow-md);
        }

    .wishlist-card-img-wrap {
        position: relative;
        background: var(--green-pale);
        aspect-ratio: 1 / 1;
        overflow: hidden;
    }

        .wishlist-card-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .wishlist-heart-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        background: var(--white);
        border: none;
        border-radius: 50%;
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: var(--shadow-sm);
        font-size: 16px;
        transition: transform 0.15s;
    }

        .wishlist-heart-btn:hover {
            transform: scale(1.15);
        }

    .wishlist-card-body {
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
    }

    .wishlist-plant-name {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-dark);
    }

    .wishlist-plant-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .wishlist-plant-shop {
        font-size: 12px;
        color: var(--text-muted);
    }

    .wishlist-plant-rating {
        display: flex;
        align-items: center;
        gap: 3px;
        font-size: 12px;
        color: var(--text-muted);
        font-weight: 600;
    }

        .wishlist-plant-rating svg {
            fill: #f5a623;
            stroke: none;
        }

    .wishlist-plant-price {
        font-size: 15px;
        font-weight: 700;
        color: var(--green-dark);
        margin-top: 4px;
    }

    .btn-add-to-cart {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        padding: 9px 0;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        background: var(--white);
        font-size: 13px;
        font-weight: 600;
        color: var(--text-mid);
        cursor: pointer;
        margin-top: 10px;
        transition: border-color 0.15s, background 0.15s, color 0.15s;
        font-family: var(--font-ui);
    }

        .btn-add-to-cart:hover {
            border-color: var(--green-soft);
            background: var(--green-pale);
            color: var(--green-mid);
        }

    .btn-remove {
        background: none;
        border: none;
        font-size: 12.5px;
        color: var(--text-muted);
        cursor: pointer;
        padding: 6px 0 2px;
        text-align: center;
        width: 100%;
        transition: color 0.15s;
        font-family: var(--font-ui);
    }

        .btn-remove:hover {
            color: var(--red);
        }

    /* ── Promo Banner ── */
    .wishlist-promo {
        background: var(--green-pale);
        border-radius: var(--radius-lg);
        padding: 32px 40px;
        display: flex;
        align-items: center;
        gap: 32px;
        overflow: hidden;
        position: relative;
    }

    .wishlist-promo-left {
        font-size: 80px;
        line-height: 1;
        flex-shrink: 0;
    }

    .wishlist-promo-text {
        flex: 1;
    }

    .wishlist-promo-title {
        font-family: var(--font-main);
        font-size: 22px;
        font-weight: 700;
        color: var(--text-dark);
        line-height: 1.3;
    }

    .wishlist-promo-sub {
        font-size: 13.5px;
        color: var(--text-muted);
        margin-top: 6px;
    }

    .btn-shop-arrivals {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
        background: var(--green-dark);
        color: var(--white);
        border-radius: var(--radius-sm);
        padding: 11px 22px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-shop-arrivals:hover {
            background: var(--green-mid);
            color: var(--white);
        }

    .wishlist-promo-right {
        font-size: 80px;
        line-height: 1;
        flex-shrink: 0;
        opacity: 0.5;
        letter-spacing: 8px;
    }
</style>

<div class="profile-page">

    @* Header Row *@
    <div class="wishlist-header-row">
        <div>
            <h1 class="profile-title">My Wishlist <span class="profile-title-emoji">🌿</span></h1>
            <p class="wishlist-count">4 items saved</p>
        </div>
        <a href="#" class="btn-share-wishlist">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
