@model List<Plantopia.Models.Plant>
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "My Wishlist";
}

<style>
    .wishlist-header-row { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:24px; }
    .wishlist-count { font-size:14px; color:var(--text-muted); margin-top:4px; }
    .btn-share-wishlist { display:flex; align-items:center; gap:7px; padding:9px 18px; border:1.5px solid var(--border); border-radius:var(--radius-sm); background:var(--white); font-size:13.5px; font-weight:500; color:var(--text-mid); cursor:pointer; transition:border-color .15s,background .15s; font-family:var(--font-ui); text-decoration:none; }
    .btn-share-wishlist:hover { border-color:var(--green-soft); background:var(--green-pale); color:var(--green-mid); }
    .wishlist-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; margin-bottom:24px; }
    .wishlist-card { background:var(--white); border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; transition:box-shadow .15s; }
    .wishlist-card:hover { box-shadow:var(--shadow-md); }
    .wishlist-card-img-wrap { position:relative; background:var(--green-pale); aspect-ratio:1/1; overflow:hidden; }
    .wishlist-card-img-wrap img { width:100%; height:100%; object-fit:cover; display:block; }
    .wishlist-heart-btn { position:absolute; top:12px; right:12px; background:var(--white); border:none; border-radius:50%; width:34px; height:34px; display:flex; align-items:center; justify-content:center; cursor:pointer; box-shadow:var(--shadow-sm); font-size:16px; transition:transform .15s; }
    .wishlist-heart-btn:hover { transform:scale(1.15); }
    .wishlist-card-body { padding:14px 16px; display:flex; flex-direction:column; gap:4px; flex:1; }
    .wishlist-plant-name { font-size:14px; font-weight:700; color:var(--text-dark); }
    .wishlist-plant-meta { display:flex; align-items:center; justify-content:space-between; }
    .wishlist-plant-shop { font-size:12px; color:var(--text-muted); }
    .wishlist-plant-price { font-size:15px; font-weight:700; color:var(--green-dark); margin-top:4px; }
    .btn-add-to-cart { display:flex; align-items:center; justify-content:center; gap:7px; width:100%; padding:9px 0; border:1.5px solid var(--border); border-radius:var(--radius-sm); background:var(--white); font-size:13px; font-weight:600; color:var(--text-mid); cursor:pointer; margin-top:10px; transition:border-color .15s,background .15s,color .15s; font-family:var(--font-ui); }
    .btn-add-to-cart:hover { border-color:var(--green-soft); background:var(--green-pale); color:var(--green-mid); }
    .btn-remove { background:none; border:none; font-size:12.5px; color:var(--text-muted); cursor:pointer; padding:6px 0 2px; text-align:center; width:100%; transition:color .15s; font-family:var(--font-ui); }
    .btn-remove:hover { color:var(--red,#e74c3c); }
    .wishlist-empty { text-align:center; padding:60px 20px; color:var(--text-muted); }
    .wishlist-empty-icon { font-size:60px; margin-bottom:16px; }
    .wishlist-promo { background:var(--green-pale); border-radius:var(--radius-lg); padding:32px 40px; display:flex; align-items:center; gap:32px; overflow:hidden; position:relative; }
    .wishlist-promo-left { font-size:80px; line-height:1; flex-shrink:0; }
    .wishlist-promo-text { flex:1; }
    .wishlist-promo-title { font-family:var(--font-main); font-size:22px; font-weight:700; color:var(--text-dark); line-height:1.3; }
    .wishlist-promo-sub { font-size:13.5px; color:var(--text-muted); margin-top:6px; }
    .btn-shop-arrivals { display:inline-flex; align-items:center; gap:8px; margin-top:16px; background:var(--green-dark); color:var(--white); border-radius:var(--radius-sm); padding:11px 22px; font-size:14px; font-weight:600; text-decoration:none; transition:background .15s; }
    .btn-shop-arrivals:hover { background:var(--green-mid); color:var(--white); }
    .wishlist-promo-right { font-size:80px; line-height:1; flex-shrink:0; opacity:.5; letter-spacing:8px; }
</style>

<div class="profile-page">

    <div class="wishlist-header-row">
        <div>
            <h1 class="profile-title">My Wishlist <span class="profile-title-emoji">🌿</span></h1>
            <p class="wishlist-count">@Model.Count item@(Model.Count != 1 ? "s" : "") saved</p>
        </div>
        <a href="#" class="btn-share-wishlist">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
            Share Wishlist
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="wishlist-empty">
            <div class="wishlist-empty-icon">🌱</div>
            <h4>Your wishlist is empty</h4>
            <p>Start adding plants you love!</p>
            <a asp-controller="Store" asp-action="Index" class="btn-shop-arrivals">Browse Plants →</a>
        </div>
    }
    else
    {
        <div class="wishlist-grid">
            @foreach (var plant in Model)
            {
                <div class="wishlist-card" id="wishlist-card-@plant.Id">
                    <div class="wishlist-card-img-wrap">
                        <img src="@plant.ImageUrl" alt="@plant.Name"
                             onerror="this.src='https://placehold.co/300x300/eef4eb/4a7c4a?text=🌿'" />
                        <button class="wishlist-heart-btn wishlist-btn wishlisted"
                                data-plant-id="@plant.Id">❤️</button>
                    </div>
                    <div class="wishlist-card-body">
                        <div class="wishlist-plant-name">@plant.Name</div>
                        <div class="wishlist-plant-meta">
                            <span class="wishlist-plant-shop">@plant.Category</span>
                        </div>
                        <div class="wishlist-plant-price">₱@plant.Price.ToString("N0")</div>
                        <button class="btn-add-to-cart">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                            </svg>
                            Add to Cart
                        </button>
                        <button class="btn-remove wishlist-btn" data-plant-id="@plant.Id">Remove</button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="wishlist-promo">
        <div class="wishlist-promo-left">🪴</div>
        <div class="wishlist-promo-text">
            <div class="wishlist-promo-title">Still looking for your<br>perfect plant?</div>
            <div class="wishlist-promo-sub">Discover more greens that'll brighten up your space.</div>
            <a asp-controller="Store" asp-action="NewArrivals" class="btn-shop-arrivals">Shop New Arrivals →</a>
        </div>
        <div class="wishlist-promo-right">🌿🌵🪴</div>
    </div>

</div>

        @section Scripts {
    <script>
        document.querySelectorAll('.wishlist-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const plantId = this.dataset.plantId;

                fetch('/Account/ToggleWishlist', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `plantId=${plantId}`
                })
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        window.location.href = '/Auth/Login';
                        return;
                    }
                    if (!data.wishlisted) {
                        // ── Remove card from page ──
                        const card = document.getElementById('wishlist-card-' + plantId);
                        if (card) card.remove();

                        // ── Update count ──
                        const remaining = document.querySelectorAll('.wishlist-card').length;
                        const countEl = document.querySelector('.wishlist-count');
                        if (countEl) countEl.textContent = `${remaining} item${remaining !== 1 ? 's' : ''} saved`;
                    }
                });
            });
        });

        // ── Remove button ──
        document.querySelectorAll('.btn-remove').forEach(btn => {
            btn.addEventListener('click', function () {
                const plantId = this.dataset.plantId;

                fetch('/Account/ToggleWishlist', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `plantId=${plantId}`
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success && !data.wishlisted) {
                        const card = document.getElementById('wishlist-card-' + plantId);
                        if (card) card.remove();

                        const remaining = document.querySelectorAll('.wishlist-card').length;
                        const countEl = document.querySelector('.wishlist-count');
                        if (countEl) countEl.textContent = `${remaining} item${remaining !== 1 ? 's' : ''} saved`;
                    }
                });
            });
        });
    </script>
}