@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "Change Password";
}

<div class="profile-page-wrapper">
    <div class="profile-page">

        <div style="margin-bottom:12px;">
            <a asp-controller="Account" asp-action="Profile"
                   style="display:inline-flex; align-items:center; gap:6px; font-size:13px; font-weight:500; color:var(--text-mid); text-decoration:none; padding:7px 16px; border:1.5px solid var(--border); border-radius:20px; background:var(--white); transition:all 0.15s;"
                   onmouseover="this.style.borderColor='var(--green-soft)'; this.style.color='var(--green-mid)'; this.style.background='var(--green-pale)';"
                   onmouseout="this.style.borderColor='var(--border)'; this.style.color='var(--text-mid)'; this.style.background='var(--white)';">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12" />
                    <polyline points="12 19 5 12 12 5" />
                </svg>
                Back
            </a>
        </div>

        <div class="profile-header">
            <h1 class="profile-title">Change Password <span class="profile-title-emoji">🔒</span></h1>
            <p class="profile-subtitle">Make sure your new password is strong and secure.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert" style="background:#f0f8f0; color:#2d5a27; border-radius:10px; padding:12px 18px; margin-bottom:16px;">
                ✅ @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert" style="background:#fff0f0; color:#a00; border-radius:10px; padding:12px 18px; margin-bottom:16px;">
                ❌ @TempData["Error"]
            </div>
        }

        <div class="profile-card">
                <h2 class="profile-card-title">Update Password</h2>

                <form asp-controller="Account" asp-action="ChangePassword" method="post" class="profile-form">

                    <div class="form-group-plantopia">
                        <label class="form-label-plantopia">Current Password</label>
                        <input type="password" name="currentPassword" class="form-input-plantopia"
                               placeholder="Enter current password" required />
                    </div>

                    <div class="form-group-plantopia">
                        <label class="form-label-plantopia">New Password</label>
                        <input type="password" name="newPassword" class="form-input-plantopia"
                               placeholder="Enter new password" required />
                    </div>

                    <div class="form-group-plantopia">
                        <label class="form-label-plantopia">Confirm New Password</label>
                        <input type="password" name="confirmPassword" class="form-input-plantopia"
                               placeholder="Re-enter new password" required />
                    </div>

                    <div class="profile-form-footer" style="justify-content:flex-end;">
                        <button type="submit" class="btn-save-changes">Update Password</button>
                    </div>

                </form>
        </div>

    </div>
</div>