@model List<Plantopia.Models.OrderSummaryViewModel>
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "My Purchase";
}
@section Styles {
    <link rel="stylesheet" href="~/css/purchases.css" />
}

<!-- Cancel Modal -->
<div id="cancelModal">
    <div class="cancel-box">
        <div class="cancel-box-title">Cancel Order</div>
        <div class="cancel-box-sub" id="cancel-order-label">Order #PT-0000</div>
        <span class="cancel-reason-label">Please select a reason:</span>
        <div class="cancel-reason-list">
            <label class="cancel-reason-item">
                <input type="radio" name="cancel-reason" value="Changed my mind" /> Changed my mind
            </label>
            <label class="cancel-reason-item">
                <input type="radio" name="cancel-reason" value="Ordered by mistake" /> Ordered by mistake
            </label>
            <label class="cancel-reason-item">
                <input type="radio" name="cancel-reason" value="Found a better price" /> Found a better price
            </label>
            <label class="cancel-reason-item">
                <input type="radio" name="cancel-reason" value="Delivery takes too long" /> Delivery takes too long
            </label>
            <label class="cancel-reason-item">
                <input type="radio" name="cancel-reason" value="Other" /> Other
            </label>
        </div>
        <div class="cancel-btn-row">
            <button class="btn-cancel-dismiss" onclick="closeCancelModal()">Go Back</button>
            <button class="btn-cancel-confirm" id="btn-confirm-cancel" onclick="confirmCancel()">Cancel Order</button>
        </div>
    </div>
</div>

<div class="profile-page-wrapper">
<div class="profile-page">

    <div class="profile-header">
        <h1 class="profile-title">My Purchase <span class="profile-title-emoji"></span></h1>
        <p class="profile-subtitle">Track and manage all your orders in one place.</p>
    </div>

    <div class="purchase-tabs">
        <a href="#" class="purchase-tab active" onclick="filterOrders('All', this); return false;">All</a>
        <a href="#" class="purchase-tab" onclick="filterOrders('Pending', this); return false;">To Pay</a>
        <a href="#" class="purchase-tab" onclick="filterOrders('ToShip', this); return false;">To Ship</a>
        <a href="#" class="purchase-tab" onclick="filterOrders('ToReceive', this); return false;">To Receive</a>
        <a href="#" class="purchase-tab" onclick="filterOrders('Completed', this); return false;">Completed</a>
        <a href="#" class="purchase-tab" onclick="filterOrders('Cancelled', this); return false;">Cancelled</a>
    </div>

    <div class="purchase-list" id="order-list">
        @if (!Model.Any())
        {
            <div class="empty-purchases">
                <div class="empty-purchases-icon"></div>
                <h4>No orders yet</h4>
                <p style="color:var(--text-muted); font-size:13px; margin-top:6px;">Start shopping and your orders will appear here!</p>
                <a asp-controller="Store" asp-action="Index"
                   style="display:inline-flex; margin-top:14px; background:var(--green-dark); color:#fff; padding:10px 24px; border-radius:8px; font-size:13px; font-weight:600; text-decoration:none;">
                    Shop Now
                </a>
            </div>
        }
        else
        {
            @foreach (var order in Model)
            {
                var statusClass = order.Status switch {
                    "Pending"   => "status-pending",
                    "ToShip"    => "status-toship",
                    "ToReceive" => "status-toreceive",
                    "Completed" => "status-completed",
                    "Cancelled" => "status-cancelled",
                    _           => "status-pending"
                };
                var statusEmoji = order.Status switch {
                    "Pending"   => "To Pay",
                    "ToShip"    => "To Ship",
                    "ToReceive" => "To Receive",
                    "Completed" => "Completed",
                    "Cancelled" => "Cancelled",
                    _           => "Pending"
                };
                var statusDesc = order.Status switch {
                    "Pending"   => "Awaiting payment verification",
                    "ToShip"    => "Your order is being prepared",
                    "ToReceive" => "Out for delivery",
                    "Completed" => "Order delivered successfully",
                    "Cancelled" => "Order was cancelled",
                    _           => "Processing"
                };
                var canCancel = order.Status == "Pending" || order.Status == "ToShip";
                var visibleItems = order.Items.Take(2).ToList();
                var extraCount = order.Items.Count - 2;

                <div class="order-card" id="order-card-@order.Id" data-status="@order.Status">
                    <div class="order-info">
                        <div class="order-number">Order #PT-@order.Id.ToString("D4")</div>
                        <div class="order-date">@order.OrderedAt.ToString("MMM dd, yyyy • hh:mm tt")</div>
                        <div class="order-total">
                            <span class="order-total-label">Total</span>
                            ₱@order.Total.ToString("N2")
                        </div>
                    </div>

                    <div class="order-images">
                        @foreach (var item in visibleItems)
                        {
                            <div class="order-img-wrap">
                                <img src="@item.PlantImageUrl" alt="@item.PlantName"
                                     onerror="this.src='https://placehold.co/52x52/eef4eb/4a7c4a?text=🌿'" />
                            </div>
                        }
                        @if (extraCount > 0)
                        {
                            <div class="order-img-more">+@extraCount<span>more</span></div>
                        }
                    </div>

                    <div class="order-status-col">
                        <div class="order-status-badge @statusClass">@statusEmoji</div>
                        <div class="order-status-desc">@statusDesc</div>
                        @if (canCancel)
                        {
                            <button class="btn-cancel-order"
                                    onclick="openCancelModal(@order.Id, 'PT-@order.Id.ToString("D4")')">
                                  Cancel Order
                            </button>
                        }
                    </div>

                    <svg class="order-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </div>
            }
        }
    </div>

</div>
</div>

@section Scripts {
<script>
    var cancelOrderId = null;

    function openCancelModal(orderId, orderLabel) {
        cancelOrderId = orderId;
        document.getElementById('cancel-order-label').textContent = 'Order #' + orderLabel;
        document.querySelectorAll('input[name="cancel-reason"]').forEach(r => r.checked = false);
        document.querySelectorAll('.cancel-reason-item').forEach(i => i.classList.remove('selected'));
        document.getElementById('cancelModal').classList.add('show');
    }

    function closeCancelModal() {
        document.getElementById('cancelModal').classList.remove('show');
        cancelOrderId = null;
    }

    // Highlight selected reason
    document.querySelectorAll('.cancel-reason-item').forEach(item => {
        item.addEventListener('click', function() {
            document.querySelectorAll('.cancel-reason-item').forEach(i => i.classList.remove('selected'));
            this.classList.add('selected');
        });
    });

    function confirmCancel() {
        var selected = document.querySelector('input[name="cancel-reason"]:checked');
        if (!selected) {
            alert('Please select a reason for cancellation.');
            return;
        }

        var btn = document.getElementById('btn-confirm-cancel');
        btn.disabled = true;
        btn.textContent = 'Cancelling...';

        fetch('/Account/CancelOrder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `orderId=${cancelOrderId}&reason=${encodeURIComponent(selected.value)}`
        })
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                btn.disabled = false;
                btn.textContent = 'Cancel Order';
                alert('Could not cancel order. Please try again.');
                return;
            }
            // Update UI without reload
            var card = document.getElementById('order-card-' + cancelOrderId);
            if (card) {
                card.dataset.status = 'Cancelled';
                var badge = card.querySelector('.order-status-badge');
                if (badge) { badge.className = 'order-status-badge status-cancelled'; badge.textContent = '❌ Cancelled'; }
                var desc = card.querySelector('.order-status-desc');
                if (desc) desc.textContent = 'Order was cancelled';
                var cancelBtn = card.querySelector('.btn-cancel-order');
                if (cancelBtn) cancelBtn.remove();
            }
            closeCancelModal();
        })
        .catch(() => {
            btn.disabled = false;
            btn.textContent = 'Cancel Order';
            alert('Network error. Please try again.');
        });
    }

    function filterOrders(status, btn) {
        document.querySelectorAll('.purchase-tab').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.order-card').forEach(card => {
            card.style.display = (status === 'All' || card.dataset.status === status) ? 'flex' : 'none';
        });
    }
</script>
}