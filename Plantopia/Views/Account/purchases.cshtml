@model List<Plantopia.Models.OrderSummaryViewModel>
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "My Purchase";
}

<style>
    .purchase-tabs { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:14px; }
    .purchase-tab { padding:6px 14px; font-size:12px; border-radius:20px; border:1.5px solid var(--border); background:var(--white); font-weight:500; color:var(--text-mid); cursor:pointer; transition:all 0.15s; text-decoration:none; }
    .purchase-tab:hover { border-color:var(--green-soft); color:var(--green-mid); background:var(--green-pale); }
    .purchase-tab.active { background:var(--green-dark); color:var(--white); border-color:var(--green-dark); font-weight:600; }
    .purchase-list { display:flex; flex-direction:column; gap:10px; }
    .order-card { background:var(--white); border-radius:var(--radius-lg); padding:14px 16px; box-shadow:var(--shadow-sm); display:flex; align-items:center; gap:14px; transition:box-shadow 0.15s; color:inherit; }
    .order-card:hover { box-shadow:var(--shadow-md); }
    .order-info { min-width:160px; }
    .order-number { font-size:12px; font-weight:700; color:var(--text-dark); }
    .order-date { font-size:11px; color:var(--text-muted); margin-top:3px; }
    .order-total { font-size:12px; font-weight:700; color:var(--green-dark); margin-top:8px; }
    .order-total-label { font-size:11px; font-weight:400; color:var(--text-muted); display:block; }
    .order-images { display:flex; align-items:center; gap:8px; flex:1; }
    .order-img-wrap { width:52px; height:52px; border-radius:var(--radius-sm); background:var(--green-pale); overflow:hidden; flex-shrink:0; }
    .order-img-wrap img { width:100%; height:100%; object-fit:cover; }
    .order-img-more { width:52px; height:52px; border-radius:var(--radius-sm); background:var(--green-pale); border:1.5px dashed var(--green-light); display:flex; flex-direction:column; align-items:center; justify-content:center; font-size:13px; font-weight:700; color:var(--green-soft); flex-shrink:0; gap:2px; }
    .order-img-more span { font-size:10px; font-weight:500; color:var(--text-muted); }
    .order-status-col { min-width:220px; display:flex; flex-direction:column; gap:4px; }
    .order-status-badge { display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:20px; font-size:11px; font-weight:700; width:fit-content; }
    .status-pending    { background:#fff8e1; color:#b8860b; }
    .status-toship     { background:#e3f2fd; color:#1565c0; }
    .status-toreceive  { background:#e8f5e9; color:#2e7d32; }
    .status-completed  { background:#e8f5e9; color:#1b5e20; }
    .status-cancelled  { background:#fce4ec; color:#c62828; }
    .order-status-desc { font-size:12px; font-weight:600; color:var(--text-dark); }
    .order-status-sub  { font-size:11px; color:var(--text-muted); line-height:1.4; }
    .btn-cancel-order  { display:inline-flex; align-items:center; gap:5px; margin-top:5px; padding:4px 10px; background:#fff; border:1.5px solid #e57373; border-radius:6px; font-size:11px; font-weight:600; color:#c62828; cursor:pointer; font-family:var(--font-ui); transition:all .15s; }
    .btn-cancel-order:hover { background:#fce4ec; }
    .order-arrow { color:var(--text-muted); flex-shrink:0; }
    .empty-purchases { text-align:center; padding:48px 20px; }
    .empty-purchases-icon { font-size:48px; margin-bottom:12px; }

    /* Cancel Modal */
    #cancelModal { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:99999; align-items:center; justify-content:center; }
    #cancelModal.show { display:flex; }
    .cancel-box { background:#fff; border-radius:18px; padding:28px 24px; max-width:400px; width:90%; font-family:'Segoe UI',sans-serif; }
    .cancel-box-title { font-size:1rem; font-weight:800; color:#1a3a1a; margin-bottom:4px; }
    .cancel-box-sub { font-size:12px; color:#888; margin-bottom:16px; }
    .cancel-reason-label { font-size:11px; font-weight:600; color:#555; margin-bottom:6px; display:block; }
    .cancel-reason-list { display:flex; flex-direction:column; gap:7px; margin-bottom:18px; }
    .cancel-reason-item { display:flex; align-items:center; gap:10px; padding:9px 12px; border:1.5px solid #e0e0e0; border-radius:9px; cursor:pointer; transition:all .15s; font-size:12.5px; color:#333; }
    .cancel-reason-item:hover { border-color:#e57373; background:#fff8f8; }
    .cancel-reason-item.selected { border-color:#c62828; background:#fce4ec; color:#c62828; font-weight:600; }
    .cancel-reason-item input { accent-color:#c62828; }
    .cancel-btn-row { display:flex; gap:10px; }
    .btn-cancel-confirm { flex:1; padding:10px; background:#c62828; color:#fff; border:none; border-radius:9px; font-size:13px; font-weight:700; cursor:pointer; font-family:'Segoe UI',sans-serif; transition:background .15s; }
    .btn-cancel-confirm:hover { background:#b71c1c; }
    .btn-cancel-confirm:disabled { background:#aaa; cursor:not-allowed; }
    .btn-cancel-dismiss { flex:1; padding:10px; background:#f5f5f5; color:#555; border:none; border-radius:9px; font-size:13px; font-weight:600; cursor:pointer; font-family:'Segoe UI',sans-serif; }
    .btn-cancel-dismiss:hover { background:#eee; }
</style>

<!-- Cancel Modal -->
<div id="cancelModal">
    <div class="cancel-box">
        <div class="cancel-box-title">Cancel Order</div>
        <div class="cancel-box-sub" id="cancel-order-label">Order #PT-0000</div>
        <span class="cancel-reason-label">Please select a reason:</span>
        <div class="cancel-reason-list">
            <label class="cancel-reason-item">
                <input type="radio" name="cancel-reason" value="Changed my mind" /> Changed my mind
            </label>
            <label class="cancel-reason-item">
                <input type="radio" name="cancel-reason" value="Ordered by mistake" /> Ordered by mistake
            </label>
            <label class="cancel-reason-item">
                <input type="radio" name="cancel-reason" value="Found a better price" /> Found a better price
            </label>
            <label class="cancel-reason-item">
                <input type="radio" name="cancel-reason" value="Delivery takes too long" /> Delivery takes too long
            </label>
            <label class="cancel-reason-item">
                <input type="radio" name="cancel-reason" value="Other" /> Other
            </label>
        </div>
        <div class="cancel-btn-row">
            <button class="btn-cancel-dismiss" onclick="closeCancelModal()">Go Back</button>
            <button class="btn-cancel-confirm" id="btn-confirm-cancel" onclick="confirmCancel()">Cancel Order</button>
        </div>
    </div>
</div>

<div class="profile-page-wrapper">
<div class="profile-page">

    <div class="profile-header">
        <h1 class="profile-title">My Purchase <span class="profile-title-emoji"></span></h1>
        <p class="profile-subtitle">Track and manage all your orders in one place.</p>
    </div>

    <div class="purchase-tabs">
        <a href="#" class="purchase-tab active" onclick="filterOrders('All', this); return false;">All</a>
        <a href="#" class="purchase-tab" onclick="filterOrders('Pending', this); return false;">To Pay</a>
        <a href="#" class="purchase-tab" onclick="filterOrders('ToShip', this); return false;">To Ship</a>
        <a href="#" class="purchase-tab" onclick="filterOrders('ToReceive', this); return false;">To Receive</a>
        <a href="#" class="purchase-tab" onclick="filterOrders('Completed', this); return false;">Completed</a>
        <a href="#" class="purchase-tab" onclick="filterOrders('Cancelled', this); return false;">Cancelled</a>
    </div>

    <div class="purchase-list" id="order-list">
        @if (!Model.Any())
        {
            <div class="empty-purchases">
                <div class="empty-purchases-icon"></div>
                <h4>No orders yet</h4>
                <p style="color:var(--text-muted); font-size:13px; margin-top:6px;">Start shopping and your orders will appear here!</p>
                <a asp-controller="Store" asp-action="Index"
                   style="display:inline-flex; margin-top:14px; background:var(--green-dark); color:#fff; padding:10px 24px; border-radius:8px; font-size:13px; font-weight:600; text-decoration:none;">
                    Shop Now
                </a>
            </div>
        }
        else
        {
            @foreach (var order in Model)
            {
                var statusClass = order.Status switch {
                    "Pending"   => "status-pending",
                    "ToShip"    => "status-toship",
                    "ToReceive" => "status-toreceive",
                    "Completed" => "status-completed",
                    "Cancelled" => "status-cancelled",
                    _           => "status-pending"
                };
                var statusEmoji = order.Status switch {
                    "Pending"   => "To Pay",
                    "ToShip"    => "To Ship",
                    "ToReceive" => "To Receive",
                    "Completed" => "Completed",
                    "Cancelled" => "Cancelled",
                    _           => "Pending"
                };
                var statusDesc = order.Status switch {
                    "Pending"   => "Awaiting payment verification",
                    "ToShip"    => "Your order is being prepared",
                    "ToReceive" => "Out for delivery",
                    "Completed" => "Order delivered successfully",
                    "Cancelled" => "Order was cancelled",
                    _           => "Processing"
                };
                var canCancel = order.Status == "Pending" || order.Status == "ToShip";
                var visibleItems = order.Items.Take(2).ToList();
                var extraCount = order.Items.Count - 2;

                <div class="order-card" id="order-card-@order.Id" data-status="@order.Status">
                    <div class="order-info">
                        <div class="order-number">Order #PT-@order.Id.ToString("D4")</div>
                        <div class="order-date">@order.OrderedAt.ToString("MMM dd, yyyy • hh:mm tt")</div>
                        <div class="order-total">
                            <span class="order-total-label">Total</span>
                            ₱@order.Total.ToString("N2")
                        </div>
                    </div>

                    <div class="order-images">
                        @foreach (var item in visibleItems)
                        {
                            <div class="order-img-wrap">
                                <img src="@item.PlantImageUrl" alt="@item.PlantName"
                                     onerror="this.src='https://placehold.co/52x52/eef4eb/4a7c4a?text=🌿'" />
                            </div>
                        }
                        @if (extraCount > 0)
                        {
                            <div class="order-img-more">+@extraCount<span>more</span></div>
                        }
                    </div>

                    <div class="order-status-col">
                        <div class="order-status-badge @statusClass">@statusEmoji</div>
                        <div class="order-status-desc">@statusDesc</div>
                        @if (canCancel)
                        {
                            <button class="btn-cancel-order"
                                    onclick="openCancelModal(@order.Id, 'PT-@order.Id.ToString("D4")')">
                                  Cancel Order
                            </button>
                        }
                    </div>

                    <svg class="order-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </div>
            }
        }
    </div>

</div>
</div>

@section Scripts {
<script>
    var cancelOrderId = null;

    function openCancelModal(orderId, orderLabel) {
        cancelOrderId = orderId;
        document.getElementById('cancel-order-label').textContent = 'Order #' + orderLabel;
        document.querySelectorAll('input[name="cancel-reason"]').forEach(r => r.checked = false);
        document.querySelectorAll('.cancel-reason-item').forEach(i => i.classList.remove('selected'));
        document.getElementById('cancelModal').classList.add('show');
    }

    function closeCancelModal() {
        document.getElementById('cancelModal').classList.remove('show');
        cancelOrderId = null;
    }

    // Highlight selected reason
    document.querySelectorAll('.cancel-reason-item').forEach(item => {
        item.addEventListener('click', function() {
            document.querySelectorAll('.cancel-reason-item').forEach(i => i.classList.remove('selected'));
            this.classList.add('selected');
        });
    });

    function confirmCancel() {
        var selected = document.querySelector('input[name="cancel-reason"]:checked');
        if (!selected) {
            alert('Please select a reason for cancellation.');
            return;
        }

        var btn = document.getElementById('btn-confirm-cancel');
        btn.disabled = true;
        btn.textContent = 'Cancelling...';

        fetch('/Account/CancelOrder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `orderId=${cancelOrderId}&reason=${encodeURIComponent(selected.value)}`
        })
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                btn.disabled = false;
                btn.textContent = 'Cancel Order';
                alert('Could not cancel order. Please try again.');
                return;
            }
            // Update UI without reload
            var card = document.getElementById('order-card-' + cancelOrderId);
            if (card) {
                card.dataset.status = 'Cancelled';
                var badge = card.querySelector('.order-status-badge');
                if (badge) { badge.className = 'order-status-badge status-cancelled'; badge.textContent = '❌ Cancelled'; }
                var desc = card.querySelector('.order-status-desc');
                if (desc) desc.textContent = 'Order was cancelled';
                var cancelBtn = card.querySelector('.btn-cancel-order');
                if (cancelBtn) cancelBtn.remove();
            }
            closeCancelModal();
        })
        .catch(() => {
            btn.disabled = false;
            btn.textContent = 'Cancel Order';
            alert('Network error. Please try again.');
        });
    }

    function filterOrders(status, btn) {
        document.querySelectorAll('.purchase-tab').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.order-card').forEach(card => {
            card.style.display = (status === 'All' || card.dataset.status === status) ? 'flex' : 'none';
        });
    }
</script>
}