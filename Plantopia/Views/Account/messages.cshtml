@* Views/Account/Messages.cshtml *@
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "Messages";
}

<style>
.messages-page {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: 20px;
}
    .messages-header-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .messages-deco {
        font-size: 50px;
        line-height: 1;
        opacity: 0.85;
        margin-top: -6px;
    }

    .messages-container {
        display: grid;
        grid-template-columns: 220px 1fr;
        background: var(--white);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        height: calc(100vh - var(--topbar-h) - 140px);
        min-height: 400px;
    }

    .conv-list-panel {
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }

    .conv-search-row {
        padding: 10px 10px 8px;
        display: flex;
        gap: 6px;
        align-items: center;
        border-bottom: 1px solid var(--border);
    }

    .conv-search-wrap {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--green-bg);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 5px 10px;
    }

    .conv-search-wrap input {
        border: none;
        background: transparent;
        outline: none;
        font-size: 11px;
        color: var(--text-dark);
        width: 100%;
        font-family: var(--font-ui);
    }

    .conv-search-wrap input::placeholder { color: var(--text-muted); }

    .conv-filter-btn {
        display: flex;
        align-items: center;
        gap: 3px;
        padding: 5px 10px;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--white);
        font-size: 11px;
        color: var(--text-mid);
        cursor: pointer;
        font-family: var(--font-ui);
        white-space: nowrap;
    }

    .conv-list {
        overflow-y: auto;
        flex: 1;
    }

    .conv-item {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 10px 12px;
        border-bottom: 1px solid var(--border);
        cursor: pointer;
        transition: background 0.15s;
        position: relative;
    }

    .conv-item:hover { background: var(--green-bg); }
    .conv-item.active { background: var(--green-pale); }

    .conv-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--green-pale);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
    }

    .conv-info { flex: 1; min-width: 0; }

    .conv-name {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-dark);
    }

    .conv-preview {
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .conv-time {
        font-size: 10px;
        color: var(--text-muted);
        flex-shrink: 0;
        margin-top: 2px;
    }

    .conv-unread-badge {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: var(--green-dark);
        color: var(--white);
        font-size: 9px;
        font-weight: 700;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .chat-panel {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }

    .chat-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
    }

    .chat-header-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--green-pale);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .chat-header-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-dark);
    }

    .chat-header-sub {
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 1px;
    }

    .btn-view-order {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        background: var(--white);
        font-size: 11.5px;
        font-weight: 500;
        color: var(--text-mid);
        cursor: pointer;
        font-family: var(--font-ui);
        transition: border-color 0.15s, background 0.15s;
        text-decoration: none;
    }

    .btn-view-order:hover {
        border-color: var(--green-soft);
        background: var(--green-pale);
        color: var(--green-mid);
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-height: 0;
    }

    .msg-row {
        display: flex;
        align-items: flex-end;
        gap: 8px;
    }

    .msg-row.msg-mine {
        flex-direction: row-reverse;
    }

    .msg-avatar {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--green-pale);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        flex-shrink: 0;
    }

    .msg-bubble-wrap {
        display: flex;
        flex-direction: column;
        max-width: 65%;
    }

    .msg-bubble {
        padding: 9px 13px;
        border-radius: 14px;
        font-size: 12.5px;
        line-height: 1.5;
        color: var(--text-dark);
        background: var(--green-bg);
    }

    .msg-row.msg-mine .msg-bubble {
        background: var(--green-dark);
        color: var(--white);
        border-bottom-right-radius: 4px;
    }

    .msg-row:not(.msg-mine) .msg-bubble {
        border-bottom-left-radius: 4px;
    }

    .msg-meta {
        font-size: 10px;
        color: var(--text-muted);
        margin-top: 3px;
        display: flex;
        align-items: center;
        gap: 3px;
    }

    .msg-row.msg-mine .msg-meta {
        justify-content: flex-end;
    }

    .chat-input-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-top: 1px solid var(--border);
    }

    .chat-input-wrap {
        flex: 1;
        display: flex;
        align-items: center;
        background: var(--green-bg);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 8px 12px;
    }

    .chat-input-wrap input {
        flex: 1;
        border: none;
        background: transparent;
        outline: none;
        font-size: 12.5px;
        color: var(--text-dark);
        font-family: var(--font-ui);
    }

    .chat-input-wrap input::placeholder { color: var(--text-muted); }

    .chat-input-icon-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        padding: 0 3px;
        transition: color 0.15s;
    }

    .chat-input-icon-btn:hover { color: var(--green-mid); }

    .btn-send {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--green-dark);
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background 0.15s;
    }

    .btn-send:hover { background: var(--green-mid); }
    .btn-send svg { stroke: white; }
</style>


<div class="messages-page">

    @* Header *@
    <div class="messages-header-row">
        <div>
            <h1 class="profile-title">Messages <span class="profile-title-emoji">🌿</span></h1>
            <p class="profile-subtitle">We're here to help! Chat with our team anytime.</p>
        </div>
        <div class="messages-deco">
    <img src="~/images/plant-deco.png" alt=""
         style="height: 100px; object-fit: contain;"
         onerror="this.style.display='none'" />
</div>
    </div>

    @* Chat Container *@
    <div class="messages-container">

        @* LEFT — Conversation List *@
        <div class="conv-list-panel">
            <div class="conv-search-row">
                <div class="conv-search-wrap">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" placeholder="Search conversations..." />
                </div>
                <button class="conv-filter-btn">
                    All
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
            </div>

            <div class="conv-list">

                @* Conversation 1 — Active *@
                <div class="conv-item active">
                    <div class="conv-avatar">🌿</div>
                    <div class="conv-info">
                        <div class="conv-name">Plantopia Support</div>
                        <div class="conv-preview">We typically reply within a few minutes.</div>
                    </div>
                    <div class="conv-time">10:30 AM</div>
                    <div class="conv-unread-badge">2</div>
                </div>

                @* Conversation 2 *@
                <div class="conv-item">
                    <div class="conv-avatar">📦</div>
                    <div class="conv-info">
                        <div class="conv-name">Order #PT-2025-0508</div>
                        <div class="conv-preview">You: Thank you!</div>
                    </div>
                    <div class="conv-time">May 8</div>
                </div>

                @* Conversation 3 *@
                <div class="conv-item">
                    <div class="conv-avatar">🪴</div>
                    <div class="conv-info">
                        <div class="conv-name">Product Inquiry</div>
                        <div class="conv-preview">You: Is this pet-friendly?</div>
                    </div>
                    <div class="conv-time">May 6</div>
                </div>

                @* Conversation 4 *@
                <div class="conv-item">
                    <div class="conv-avatar">🚚</div>
                    <div class="conv-info">
                        <div class="conv-name">Delivery Concern</div>
                        <div class="conv-preview">Agent: Sure! We'll check it for you.</div>
                    </div>
                    <div class="conv-time">Apr 28</div>
                </div>

                @* Conversation 5 *@
                <div class="conv-item">
                    <div class="conv-avatar">🔄</div>
                    <div class="conv-info">
                        <div class="conv-name">Return / Refund</div>
                        <div class="conv-preview">You: I'd like to return this item.</div>
                    </div>
                    <div class="conv-time">Apr 20</div>
                </div>

            </div>
        </div>

        @* RIGHT — Chat Window *@
        <div class="chat-panel">

            @* Chat Header *@
            <div class="chat-header">
                <div class="chat-header-avatar">🌿</div>
                <div>
                    <div class="chat-header-name">Plantopia Support</div>
                    <div class="chat-header-sub">We typically reply within a few minutes.</div>
                </div>
                <a href="#" class="btn-view-order">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 3h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    </svg>
                    View Order
                </a>
            </div>

            @* Messages *@
            <div class="chat-messages">

                @* Support message *@
                <div class="msg-row">
                    <div class="msg-avatar">🌿</div>
                    <div class="msg-bubble-wrap">
                        <div class="msg-bubble">Hi Maria! 👋<br>How can we help you today?</div>
                        <div class="msg-meta">10:30 AM</div>
                    </div>
                </div>

                @* User message *@
                <div class="msg-row msg-mine">
                    <div class="msg-bubble-wrap">
                        <div class="msg-bubble">Hi! I'd like to know more about the care tips for my Fiddle Leaf Fig.</div>
                        <div class="msg-meta">10:31 AM ✓✓</div>
                    </div>
                </div>

                @* Support message *@
                <div class="msg-row">
                    <div class="msg-avatar">🌿</div>
                    <div class="msg-bubble-wrap">
                        <div class="msg-bubble">Sure! Fiddle Leaf Fig loves bright, indirect light and prefers to dry out a bit between waterings. Would you like us to send you a care guide?</div>
                        <div class="msg-meta">10:32 AM</div>
                    </div>
                </div>

                @* User message *@
                <div class="msg-row msg-mine">
                    <div class="msg-bubble-wrap">
                        <div class="msg-bubble">Yes, please! That would be great. 🌿</div>
                        <div class="msg-meta">10:33 AM ✓✓</div>
                    </div>
                </div>

                @* Support message *@
                <div class="msg-row">
                    <div class="msg-avatar">🌿</div>
                    <div class="msg-bubble-wrap">
                        <div class="msg-bubble">Here you go! 🌿<br>We've sent the care guide to your email.<br>Let us know if you have other questions!</div>
                        <div class="msg-meta">10:34 AM</div>
                    </div>
                </div>

            </div>

            @* Input Row *@
            <div class="chat-input-row">
                <div class="chat-input-wrap">
                    <input type="text" placeholder="Type your message..." />
                    <button class="chat-input-icon-btn" title="Attach file">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                        </svg>
                    </button>
                    <button class="chat-input-icon-btn" title="Emoji">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M8 13s1.5 2 4 2 4-2 4-2"/>
                            <line x1="9" y1="9" x2="9.01" y2="9"/>
                            <line x1="15" y1="9" x2="15.01" y2="9"/>
                        </svg>
                    </button>
                </div>
                <button class="btn-send">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="22" y1="2" x2="11" y2="13"/>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                </button>
            </div>

        </div>
    </div>
</div>
