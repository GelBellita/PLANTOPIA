@model List<Plantopia.Models.Plant>

@{
    Layout = "_SideTopBar";
    ViewData["Title"] = "New Arrivals — Plantopia";
    ViewData["PromoTitle"] = "Fresh finds<br>for your space.";
    ViewData["PromoSub"] = "Be the first to bring home our newest plants and accessories.";
    ViewData["PromoCta"] = "Shop Now →";
}

<div class="page-banner">
    <div class="page-banner-bg"></div>
    <div class="page-banner-bg" style="background-image: url('/images/new_arrivals.png');"></div>
    <div class="page-banner-text">
        <h2>New Arrivals</h2>
        <p>Explore the latest additions to our collection<br>and find something new to love.</p>
        <a href="#" class="btn btn-plant">Explore New Arrivals</a>
    </div>
</div>

<div class="section-header">
    <h4>All New Arrivals</h4>
    <div class="filter-sort">
        Sort by:
        <select class="sort-select">
            <option>Newest First</option>
            <option>Price: Low to High</option>
            <option>Bestselling</option>
        </select>
    </div>
</div>

<div class="row g-3">
    @foreach (var item in Model)
    {
        <div class="col-6 col-md-4 col-lg-4">
            <div class="g-card">
                <div class="g-img-wrap">
                    <img src="@item.ImageUrl" alt="@item.Name" class="g-img" />
                    <button class="g-wish-btn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                        </svg>
                    </button>
                </div>
                <div class="g-info">
                    <div class="g-name">@item.Name</div>
                    <div class="g-sub">@item.Category</div>
                    <div class="g-rating">
                        <span class="g-stars">★★★★★</span>
                        <span>@item.Rating</span>
                    </div>
                    <div class="g-price-row">
                        <span class="g-price">₱@item.Price.ToString("N0")</span>
                        <button class="g-cart-btn">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <circle cx="9" cy="21" r="1" />
                                <circle cx="20" cy="21" r="1" />
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>