@{
    Layout = "_SideTopBar";
    ViewData["Title"] = "Plant Care — Plantopia";
    ViewData["PromoTitle"] = "Healthy plants,<br>happy life.";
    ViewData["PromoSub"] = "Discover expert tips and essentials to keep your plants thriving.";
    ViewData["PromoCta"] = "Learn More →";
}

<div class="page-banner">
    <div class="page-banner-bg"></div>
    <div class="page-banner-bg" style="background-image: url('/images/plant_care.png');"></div>
    <div class="page-banner-text">
        <h2>Plant Care</h2>
        <p>Everything you need to keep your plants<br>healthy, vibrant, and thriving.</p>
        <a href="#" class="btn btn-plant">Explore Guides</a>
    </div>
</div>

<div class="section-header">
    <h4>Care Guides</h4>
    <a href="#" class="view-all-link">View all guides →</a>
</div>

<div class="row g-3 mb-4">
    @foreach (var g in new[] {
        ("WATERING",        "How Often Should You Water Your Plants?",       "Learn the right watering schedule for different plant types.",              "monstera.jpg"),
        ("LIGHT",           "Understanding Light for Healthy Growth",        "Find out how light affects your plants and how to place them right.",       "snake.jpg"),
        ("SOIL & FERTILIZER","Best Soil & Fertilizer for Your Plants",       "Give your plants the right nutrition they need to thrive.",                 "succulent.jpg"),
        ("PRUNING",         "Pruning 101: Keep Plants Healthy",              "Tips on when and how to prune for better growth.",                          "plant.png"),
        ("PEST CARE",       "How to Identify & Treat Common Pests",         "Spot the problem early and keep your plants pest-free.",                    "monstera.jpg")
    })
    {
        <div class="col-6 col-md-4 col-xl">
            <div class="guide-card">
                <img src="~/images/@g.Item4" alt="@g.Item2" class="guide-img" />
                <div class="guide-info">
                    <div class="guide-tag">@g.Item1</div>
                    <div class="guide-title">@g.Item2</div>
                    <div class="guide-desc">@g.Item3</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="section-header mt-2">
    <h4>Plant Care Essentials</h4>
    <a href="#" class="view-all-link">View all products →</a>
</div>

<div class="row g-3">
    @foreach (var p in new[] {
        ("Plant Mister Spray Bottle",       "₱250", "plant.png"),
        ("Organic Potting Mix 2L",          "₱320", "succulent.jpg"),
        ("Liquid Plant Fertilizer (250ml)", "₱280", "monstera.jpg"),
        ("Pruning Shears",                  "₱350", "snake.jpg"),
        ("Soil Moisture Meter",             "₱450", "plant.png"),
        ("Sticky Pest Traps (10 pcs)",      "₱120", "succulent.jpg")
    })
    {
        <div class="col-6 col-md-4 col-xl-2">
            <div class="g-card">
                <div class="g-img-wrap">
                    <img src="~/images/@p.Item3" alt="@p.Item1" class="g-img" />
                    <button class="g-wish-btn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    </button>
                </div>
                <div class="g-info">
                    <div class="g-name">@p.Item1</div>
                    <div class="g-price-row">
                        <span class="g-price">@p.Item2</span>
                        <button class="g-cart-btn">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>