@{
    Layout = "_SideTopBar";
    ViewData["Title"] = "Plant Care — Plantopia";
    ViewData["PromoTitle"] = "Healthy plants,<br>happy life.";
    ViewData["PromoSub"] = "Discover expert tips and essentials to keep your plants thriving.";
    ViewData["PromoCta"] = "Learn More →";
}

<div class="page-banner">
    <div class="page-banner-bg" style="background-image: url('/images/plant_care.png');"></div>
    <div class="page-banner-text">
        <h2>Plant Care</h2>
        <p>Everything you need to keep your plants<br>healthy, vibrant, and thriving.</p>
        <a href="#" class="btn btn-plant">Explore Guides</a>
    </div>
</div>

<div class="section-header">
    <h4>Care Guides</h4>
</div>

<div class="row g-3 mb-4">
        @foreach (var g in new[] {
        ("WATERING",         "How Often Should You Water Your Plants?",      "Learn the right watering schedule for different plant types.",         "watering.png"),
        ("LIGHT",            "Understanding Light for Healthy Growth",       "Find out how light affects your plants and how to place them right.",  "light.png"),
        ("SOIL & FERTILIZER","Best Soil & Fertilizer for Your Plants",      "Give your plants the right nutrition they need to thrive.",            "soil.png"),
        ("PRUNING",          "Pruning 101: Keep Plants Healthy",             "Tips on when and how to prune for better growth.",                     "pruning.png"),
        ("PEST CARE",        "How to Identify & Treat Common Pests",        "Spot the problem early and keep your plants pest-free.",               "pest.png"),
        ("REPOTTING",        "When & How to Repot Your Plants",             "Give your plant a fresh start with the right pot and soil mix.",       "repotting.png")
    })
    {
        <div class="col-6 col-md-4 col-lg-4">
            <div class="guide-card h-100" style="cursor:pointer;"
                 onclick="openGuideModal('@g.Item1', '@g.Item2', '@g.Item3', '@g.Item4')">
                <img src="~/images/@g.Item4" alt="@g.Item2" class="guide-img" />
                <div class="guide-info">
                    <div class="guide-tag">@g.Item1</div>
                    <div class="guide-title">@g.Item2</div>
                    <div class="guide-desc">@g.Item3</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Guide Modal -->
<div id="guideModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:9999; align-items:center; justify-content:center; padding:20px;">
    <div style="background:#fff; border-radius:18px; width:100%; max-width:800px; max-height:90vh; overflow-y:auto; position:relative;">
        <img id="gm-img" src="" style="width:100%; height:280px; object-fit:cover; border-radius:18px 18px 0 0;" />
        <button onclick="closeGuideModal()" style="position:absolute; top:14px; right:14px; background:rgba(255,255,255,0.9); border:none; border-radius:50%; width:32px; height:32px; font-size:16px; cursor:pointer;">✕</button>
        <div style="padding:32px 36px;">
            <div id="gm-tag" style="font-size:0.7rem; font-weight:700; letter-spacing:2px; color:#4a7c3f; margin-bottom:8px;"></div>
            <h2 id="gm-title" style="font-family:'Playfair Display',serif; color:#1a3a1a; font-size:1.6rem; margin-bottom:16px;"></h2>
            <p id="gm-desc" style="font-size:0.92rem; color:#555; line-height:1.8; margin-bottom:20px;"></p>

            <div id="gm-tips" style="background:#f4f8f4; border-radius:12px; padding:20px 24px;">
                <div style="font-size:0.78rem; font-weight:700; color:#2d5a27; margin-bottom:12px; letter-spacing:1px;">💡 QUICK TIPS</div>
                <ul id="gm-tips-list" style="margin:0; padding-left:18px; font-size:0.88rem; color:#3a5a3a; line-height:2;"></ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                const guideDetails = {
            'WATERING': {
                desc: 'Watering is one of the most important aspects of plant care. Overwatering is the #1 killer of houseplants — always check the soil before watering.',
                tips: ['Check soil moisture before watering — stick a finger 1 inch deep', 'Water deeply but infrequently', 'Use room-temperature water', 'Water in the morning for best results', 'Ensure pots have drainage holes']
            },
            'LIGHT': {
                desc: 'Light is food for your plants. Understanding the right light conditions for each plant will help it thrive and grow strong.',
                tips: ['Place sun-loving plants near south-facing windows', 'Rotate plants every 2 weeks for even growth', 'Avoid placing plants in direct afternoon sun', 'Use grow lights in dark rooms', 'Dust leaves to maximize light absorption']
            },
            'SOIL & FERTILIZER': {
                desc: 'The right soil gives your plants the foundation they need. Fertilizing during the growing season boosts growth and keeps plants healthy.',
                tips: ['Use well-draining potting mix for most plants', 'Fertilize every 4-6 weeks during spring and summer', 'Avoid fertilizing in winter', 'Always water before applying fertilizer', 'Less is more — over-fertilizing can burn roots']
            },
            'PRUNING': {
                desc: 'Regular pruning keeps your plants healthy, encourages new growth, and maintains a beautiful shape.',
                tips: ['Use clean, sharp scissors or pruning shears', 'Remove dead or yellowing leaves first', 'Prune during the growing season', 'Never remove more than 1/3 of the plant at once', 'Wipe tools with alcohol between plants']
            },
            'PEST CARE': {
                desc: 'Pests can quickly damage your plants. Early detection and treatment is key to keeping your plants healthy and pest-free.',
                tips: ['Inspect plants weekly for early signs of pests', 'Isolate affected plants immediately', 'Wipe leaves with neem oil solution', 'Use sticky traps to monitor pest activity', 'Keep leaves dry to prevent fungal issues']
            },
            'REPOTTING': {
                desc: 'Repotting gives your plant fresh soil and more room to grow. Knowing when and how to repot is essential for long-term plant health.',
                tips: ['Repot when roots start coming out of drainage holes', 'Choose a pot 1-2 inches larger than the current one', 'Use fresh potting mix when repotting', 'Water thoroughly after repotting', 'Avoid repotting in winter']
            }
        };

        function openGuideModal(tag, title, desc, img) {
            document.getElementById('gm-tag').textContent = tag;
            document.getElementById('gm-title').textContent = title;
            document.getElementById('gm-img').src = '/images/' + img;

            const detail = guideDetails[tag] || { desc: desc, tips: [] };
            document.getElementById('gm-desc').textContent = detail.desc;

            const tipsList = document.getElementById('gm-tips-list');
            tipsList.innerHTML = detail.tips.map(t => `<li>${t}</li>`).join('');

            document.getElementById('guideModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeGuideModal() {
            document.getElementById('guideModal').style.display = 'none';
            document.body.style.overflow = '';
        }

        document.getElementById('guideModal').addEventListener('click', function(e) {
            if (e.target === this) closeGuideModal();
        });
    </script>
}