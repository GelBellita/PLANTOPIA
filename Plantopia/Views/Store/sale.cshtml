@model List<Plantopia.Models.Plant>

@{
    Layout = "_SideTopBar";
    ViewData["Title"] = "Sale — Plantopia";
    ViewData["PromoTitle"] = "Big savings for<br>green living.";
    ViewData["PromoSub"] = "Enjoy special discounts on your favorite plants and accessories.";
    ViewData["PromoCta"] = "Shop Sale →";
}

<div class="page-banner">
    <div class="page-banner-bg"></div>
    <div class="page-banner-bg" style="background-image: url('/images/background/sales_bg.png');"></div>
    <div class="page-banner-text">
        <h2>Sale</h2>
        <p>Great plants. Better prices.<br>Limited time offers on selected items.</p>
        <a href="#" class="btn btn-plant">Shop the Sale</a>
    </div>
</div>

<div class="section-header">
    <h4>All Sale Items</h4>
    <div class="filter-sort">
        Sort by:
        <select class="sort-select">
            <option>Featured</option>
            <option>Price: Low to High</option>
            <option>Biggest Discount</option>
        </select>
    </div>
</div>

<div class="row g-3">
    @foreach (var item in Model)
    {
        @* ── compute sale price from discount percent ── *@
        var salePrice = item.DiscountPercent.HasValue
            ? (int)(item.Price * (1 - item.DiscountPercent.Value / 100m))
            : (int)item.Price;

        <div class="col-6 col-md-4 col-xl-2half">
            <div class="g-card">
                <div class="g-img-wrap">
                    @* ── show discount badge only if plant has a discount ── *@
                    @if (item.DiscountPercent.HasValue)
                    {
                        <span class="sale-badge">-@item.DiscountPercent%</span>
                    }
                    <img src="@item.ImageUrl" alt="@item.Name" class="g-img" />
                    <button class="g-wish-btn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                        </svg>
                    </button>
                </div>
                <div class="g-info">
                    <div class="g-name">@item.Name</div>
                    <div class="g-sub">@item.Category</div>
                    <div class="g-rating">
                        <span class="g-stars">★★★★★</span>
                        <span>@item.Rating</span>
                    </div>
                    <div class="g-price-row">
                        <div>
                            @* ── show original price crossed out + discounted price ── *@
                            <span class="g-price-old">₱@item.Price.ToString("N0")</span>
                            <span class="g-price">₱@salePrice.ToString("N0")</span>
                        </div>
                        <button class="g-cart-btn">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <circle cx="9" cy="21" r="1" />
                                <circle cx="20" cy="21" r="1" />
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>