@{
    Layout = "_SideTopBar";
    ViewData["Title"] = "Sale — Plantopia";
    ViewData["PromoTitle"] = "Big savings for<br>green living.";
    ViewData["PromoSub"] = "Enjoy special discounts on your favorite plants and accessories.";
    ViewData["PromoCta"] = "Shop Sale →";
}

<div class="page-banner">
    <div class="page-banner-bg"></div>
    <div class="page-banner-bg" style="background-image: url('/images/sales_bg.png');"></div>
    <div class="page-banner-text">
        <h2>Sale</h2>
        <p>Great plants. Better prices.<br>Limited time offers on selected items.</p>
        <a href="#" class="btn btn-plant">Shop the Sale</a>
    </div>
</div>

<div class="section-header">
    <h4>All Sale Items</h4>
    <div class="filter-sort">
        Sort by:
        <select class="sort-select">
            <option>Featured</option>
            <option>Price: Low to High</option>
            <option>Biggest Discount</option>
        </select>
    </div>
</div>

<div class="row g-3">
    @foreach (var p in new[] {
        ("Monstera Deliciosa",  "By Green Haven PH",    "-20%", "₱1,200",   "₱960",  "Monstera Deliciosa.png"),
        ("Snake Plant",         "By Cebu Plant Shop",   "-15%", "₱450",     "₱380",  "snake.jpg"),
        ("Fiddle Leaf Fig",     "By Plantita Cebu",     "-25%", "₱1,200",   "₱900",  "Fiddle Leaf Fig.jpg"),
        ("Pothos Golden",       "By Green Haven PH",    "-20%", "₱350",     "₱280",  "Golden Pothos.png"),
        ("Aglaonema Red",       "By Leaf & Stem PH",    "-30%", "₱600",     "₱420",  "Aglaonema Pink Dalmatian.jpg"),
        ("Echeveria Elegans",   "By Succulent Lover",   "-15%", "₱280",     "₱238",  "Echeveria.png")
    })
    {
        <div class="col-6 col-md-4 col-xl-2">
            <div class="g-card">
                <div class="g-img-wrap">
                    <span class="sale-badge">@p.Item3</span>
                    <img src="~/images/@p.Item6" alt="@p.Item1" class="g-img" />
                    <button class="g-wish-btn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    </button>
                </div>
                <div class="g-info">
                    <div class="g-name">@p.Item1</div>
                    <div class="g-sub">@p.Item2</div>
                    <div class="g-price-row">
                        <div>
                            <span class="g-price-old">@p.Item4</span>
                            <span class="g-price">@p.Item5</span>
                        </div>
                        <button class="g-cart-btn">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
