@{
    Layout = "_SideTopBar";
    ViewData["Title"] = "Pots & Planters — Plantopia";
    ViewData["PromoTitle"] = "Style your<br>space naturally.";
    ViewData["PromoSub"] = "Beautiful pots for every plant and every corner.";
    ViewData["PromoCta"] = "Shop Now →";
}

<div class="page-banner">
    <div class="page-banner-bg"></div>
    <div class="page-banner-text">
        <h2>Pots &amp; Planters 🌿</h2>
        <p>Find the perfect pots and planters to<br>complement your plants and home.</p>
        <a href="#" class="btn btn-plant">Shop Now</a>
    </div>
    <img src="~/images/home_plnts.png" alt="Pots" class="page-banner-img" />
</div>

<div class="filter-bar">
    <select class="filter-select">
        <option>All Materials</option>
        <option>Ceramic</option>
        <option>Natural Fiber</option>
        <option>Metal</option>
        <option>Concrete</option>
    </select>
    <select class="filter-select">
        <option>All Sizes</option>
        <option>4 inch</option>
        <option>5 inch</option>
        <option>6 inch</option>
        <option>7 inch</option>
    </select>
    <select class="filter-select">
        <option>All Colors</option>
        <option>White</option>
        <option>Green</option>
        <option>Brown</option>
    </select>
    <select class="filter-select">
        <option>Price Range</option>
        <option>Under ₱300</option>
        <option>₱300–₱500</option>
        <option>₱500+</option>
    </select>
    <div class="filter-sort">
        Sort by:
        <select class="sort-select">
            <option>Featured</option>
            <option>Price: Low to High</option>
            <option>Newest</option>
        </select>
    </div>
</div>

<div class="row g-3">
    @foreach (var p in new[] {
        ("Minimalist Ceramic Pot",      "Ceramic • 5 inch",         "₱450", "plant.png"),
        ("Ribbed Planter",              "Ceramic • 6 inch",         "₱550", "snake.jpg"),
        ("Green Matte Pot",             "Ceramic • 5 inch",         "₱420", "succulent.jpg"),
        ("Terrazzo Planter",            "Ceramic • 6 inch",         "₱650", "monstera.jpg"),
        ("Seagrass Basket",             "Natural Fiber • 7 inch",   "₱550", "plant.png"),
        ("Modern Planter with Stand",   "Metal • 6 inch",           "₱750", "snake.jpg"),
        ("Geometric Pot",               "Ceramic • 4 inch",         "₱380", "succulent.jpg"),
        ("Terracotta Pot",              "Terracotta • 5 inch",      "₱320", "monstera.jpg"),
        ("Concrete Planter",            "Concrete • 6 inch",        "₱680", "plant.png"),
        ("Scandinavian Planter",        "Ceramic • 6 inch",         "₱790", "snake.jpg"),
        ("Charcoal Pot",                "Ceramic • 5 inch",         "₱480", "succulent.jpg"),
        ("Hanging Planter",             "Ceramic • 6 inch",         "₱600", "monstera.jpg")
    })
    {
        <div class="col-6 col-md-4 col-xl-2">
            <div class="g-card">
                <div class="g-img-wrap">
                    <img src="~/images/@p.Item4" alt="@p.Item1" class="g-img" />
                    <button class="g-wish-btn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    </button>
                </div>
                <div class="g-info">
                    <div class="g-name">@p.Item1</div>
                    <div class="g-sub">@p.Item2</div>
                    <div class="g-price-row">
                        <span class="g-price">@p.Item3</span>
                        <button class="g-cart-btn">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="store-footer">
    <span>© 2025 Plantopia. All rights reserved.</span>
    <div>
        <a href="#">About Us</a>
        <a href="#">Contact</a>
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
    </div>
</div>
