            </div>
            <div class="product-info">
                <div class="product-name">Echeveria</div>
                <div class="product-seller">Succulents</div>
                <div class="product-rating"><span class="product-stars">★★★★★</span><span class="product-rating-num">4.9</span></div>
                <div class="product-price">₱250</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-4">
        <div class="product-card">
            <div class="product-img-wrap">
                <img src="/images/Calachuchi.png" alt="Calachuchi" style="width:100%;height:100%;object-fit:cover;" />
                <button class="product-wish-btn"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg></button>
            </div>
            <div class="product-info">
                <div class="product-name">Calachuchi</div>
                <div class="product-seller">Outdoor Plants</div>
                <div class="product-rating"><span class="product-stars">★★★★★</span><span class="product-rating-num">4.8</span></div>
                <div class="product-price">₱320</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-4">
        <div class="product-card">
            <div class="product-img-wrap">
                <img src="/images/String of Pearls.png" alt="String of Pearls" style="width:100%;height:100%;object-fit:cover;" />
                <button class="product-wish-btn"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg></button>
            </div>
            <div class="product-info">
                <div class="product-name">String of Pearls</div>
                <div class="product-seller">Hanging Plants</div>
