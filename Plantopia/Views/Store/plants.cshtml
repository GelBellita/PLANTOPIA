@model List<Plantopia.Models.Plant>

@{
    Layout = "_SideTopBar";
    ViewData["Title"] = "Plants";
    ViewData["PromoTitle"] = "Bring nature<br>to your home.";
    ViewData["PromoSub"] = "Discover our best-selling plants today!";
    ViewData["PromoCta"] = "Shop Now →";

    var query = ViewData["Query"]?.ToString();
    var category = ViewData["Category"]?.ToString();
    var wishlistedIds = ViewData["WishlistedIds"] as List<int> ?? new List<int>();
}
@section Styles {
    <link rel="stylesheet" href="~/css/plants.css" asp-append-version="true" />
}

<div class="plants-banner">
    <div class="plants-banner-bg"></div>
    <div class="plants-banner-text">
        <h2>Find your perfect plant</h2>
        <p>Green your space with plants<br>that bring life and joy.</p>
        <a asp-controller="Store" asp-action="Plants" class="btn btn-plant">Shop Now</a>
    </div>
</div>

@* ── Show NoResults TempData if naa ── *@
@if (TempData["NoResults"] != null)
{
    <div class="alert" style="background:#fef3f3; color:#c0392b; border-radius:10px; padding:12px 18px; margin-bottom:16px;">
        @TempData["NoResults"]
    </div>
}

@* ── Show search filter label kung naa query ── *@
@if (!string.IsNullOrEmpty(query))
{
    <div class="section-header mb-3">
        <h4>Results for "@query"</h4>
        <a asp-controller="Store" asp-action="Plants" class="view-all-link">Clear filter ×</a>
    </div>
}

<div class="section-header mb-1">
    <h4>Shop by Category</h4>
</div>

@* Category cards — show lang kung walay search query *@
<div class="row g-3 mb-4">
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <a asp-controller="Store" asp-action="Plants" asp-route-category="Indoor Plants"
                   class="cat-card @(category == "Indoor Plants" ? "cat-card-active" : "")"
                   style="background-image:url('/images/indoor_cat.png'); background-repeat:no-repeat; background-size:auto 90%; background-position:right center;">
                <div>
                    <div class="cat-card-label">Indoor Plants</div>
                    <div class="cat-card-sub">Beautiful plants for<br>your home</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-controller="Store" asp-action="Plants" asp-route-category="Outdoor Plants"
                   class="cat-card @(category == "Outdoor Plants" ? "cat-card-active" : "")"
                   style="background-image:url('/images/outdoor_cat.png'); background-repeat:no-repeat; background-size:auto 90%; background-position:right center;">
                <div>
                    <div class="cat-card-label">Outdoor Plants</div>
                    <div class="cat-card-sub">Thrives in your<br>outdoor space</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-controller="Store" asp-action="Plants" asp-route-category="Succulents"
                   class="cat-card @(category == "Succulents" ? "cat-card-active" : "")"
                   style="background-image:url('/images/succulent_cat.png'); background-repeat:no-repeat; background-size:auto 90%; background-position:right center;">
                <div>
                    <div class="cat-card-label">Succulents</div>
                    <div class="cat-card-sub">Small plants,<br>big beauty</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-controller="Store" asp-action="Plants" asp-route-category="Hanging Plants"
                   class="cat-card @(category == "Hanging Plants" ? "cat-card-active" : "")"
                   style="background-image:url('/images/hanging_cat.png'); background-repeat:no-repeat; background-size:auto 90%; background-position:right center;">
                <div>
                    <div class="cat-card-label">Hanging Plants</div>
                    <div class="cat-card-sub">Perfect for<br>any corner</div>
                </div>
            </a>
        </div>
    </div>
</div>
@* ── Products Section ── *@
<div class="section-header" mt-1>
    <h4>@(!string.IsNullOrEmpty(category) ? category : string.IsNullOrEmpty(query) ? "Best Sellers" : $"Found {Model.Count} result(s)")</h4>
    @if (string.IsNullOrEmpty(query))
    {
        <a asp-controller="Store" asp-action="BestSellers" class="view-all-link">View all ›</a>
    }
</div>


@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <p style="color:#8a9e8a; font-size:1rem;">
            No plants found. Try another keyword!
        </p>
        <a asp-controller="Store" asp-action="Plants" class="btn btn-plant mt-3">View All Plants</a>
    </div>
}
else
{
    <div class="row g-3">
       
        @foreach (var plant in Model)
        {
            <div class="col-6 col-md-4 col-xl-2half">
                    <div class="plant-product-card" style="cursor:pointer;"
                         onclick="openPlantModal('@plant.Name', '@plant.Category', '@plant.Price', '@plant.ImageUrl', '@plant.Description')">
                    <div class="plant-product-img-wrap">
                        <img src="@plant.ImageUrl" alt="@plant.Name" class="plant-product-img" />
                        <button class="plant-wish-btn wishlist-btn @(wishlistedIds.Contains(plant.Id) ? "wishlisted" : "")"
                                data-plant-id="@plant.Id"
                                onclick="event.stopPropagation()">
                            <svg width="14" height="14" viewBox="0 0 24 24"
                                 fill="@(wishlistedIds.Contains(plant.Id) ? "currentColor" : "none")"
                                 stroke="currentColor" stroke-width="2.2">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                            </svg>
                        </button>
                    </div>
                    <div class="plant-product-info">
                     
                        <div class="plant-product-name">@plant.Name</div>
                        <div class="plant-product-seller">@plant.Category</div>
                        <div class="plant-product-rating">
                            <span class="plant-product-stars">★★★★★</span>
                        </div>
                        <div class="plant-product-price">₱@plant.Price.ToString("N0")</div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.wishlist-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const plantId = this.dataset.plantId;
                fetch('/Account/ToggleWishlist', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `plantId=${plantId}`
                })
                .then(res => res.json())
                .then(data => {
                    if (!data.success) { window.location.href = '/Auth/Login'; return; }
                    const svg = this.querySelector('svg');
                    if (data.wishlisted) {
                        this.classList.add('wishlisted');
                        if (svg) svg.setAttribute('fill', 'currentColor');
                    } else {
                        this.classList.remove('wishlisted');
                        if (svg) svg.setAttribute('fill', 'none');
                    }
                });
            });
        });
    </script>
}