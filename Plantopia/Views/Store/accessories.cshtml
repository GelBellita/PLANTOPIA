@{
    Layout = "_SideTopBar";
    ViewData["Title"] = "Accessories — Plantopia";
    ViewData["PromoTitle"] = "Little things<br>make a big difference.";
    ViewData["PromoSub"] = "Explore our plant accessories to care better and grow greener.";
    ViewData["PromoCta"] = "Shop Accessories →";
}

<div class="page-banner">
    <div class="page-banner-bg"></div>
    <div class="page-banner-text">
        <h2>Accessories 🌿</h2>
        <p>Handpicked accessories to make<br>plant care easier and more enjoyable.</p>
        <a href="#" class="btn btn-plant">Discover Accessories</a>
    </div>
    <img src="~/images/home_plnts.png" alt="Accessories" class="page-banner-img" />
</div>

<div class="section-header">
    <h4>Shop by Category</h4>
    <a href="#" class="view-all-link">View all categories →</a>
</div>

<div class="row g-3 mb-4">
    @foreach (var c in new[] {
        ("Plant Care Tools",    "Essential tools for every plant parent",      "🪛"),
        ("Watering & Misting",  "Make watering simple and effective",           "🚿"),
        ("Soil & Fertilizers",  "Nourish your plants the right way",            "🌱"),
        ("Plant Supports",      "Help your plants grow strong and tall",        "🪜"),
        ("Decor & Accents",     "Add the perfect touch to your green space",    "🎨"),
        ("Gift Ideas",          "Perfect gifts for plant lovers",               "🎁")
    })
    {
        <div class="col-6 col-md-4 col-xl-2">
            <a href="#" class="acc-cat-card">
                <div style="font-size:2rem;">@c.Item3</div>
                <div class="acc-cat-label">@c.Item1</div>
                <div class="acc-cat-sub">@c.Item2</div>
            </a>
        </div>
    }
</div>

<div class="section-header mt-2">
    <h4>Best Accessories</h4>
    <a href="#" class="view-all-link">View all accessories →</a>
</div>

<div class="row g-3">
    @foreach (var p in new[] {
        ("Pruning Shears",          "Heavy Duty • 8 inch",          "₱350", "plant.png"),
        ("Glass Plant Mister",      "300ml",                        "₱250", "snake.jpg"),
        ("Organic Potting Mix 2L",  "All-Purpose • 2 Liters",       "₱320", "succulent.jpg"),
        ("Plant Humidifier",        "USB Rechargeable",             "₱650", "monstera.jpg"),
        ("Moss Pole",               "Coco Coir • 30cm",             "₱280", "plant.png"),
        ("Decorative Pebbles",      "1kg",                          "₱180", "snake.jpg")
    })
    {
        <div class="col-6 col-md-4 col-xl-2">
            <div class="g-card">
                <div class="g-img-wrap">
                    <img src="~/images/@p.Item4" alt="@p.Item1" class="g-img" />
                    <button class="g-wish-btn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    </button>
                </div>
                <div class="g-info">
                    <div class="g-name">@p.Item1</div>
                    <div class="g-sub">@p.Item2</div>
                    <div class="g-price-row">
                        <span class="g-price">@p.Item3</span>
                        <button class="g-cart-btn">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="store-footer">
    <span>© 2025 Plantopia. All rights reserved.</span>
    <div>
        <a href="#">About Us</a>
        <a href="#">Contact</a>
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
    </div>
</div>
