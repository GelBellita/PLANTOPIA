@model List<Plantopia.Models.Plant>

@{
    Layout = "_SideTopBar";
    ViewData["Title"] = "Best Sellers — Plantopia";
    ViewData["PromoTitle"] = "Loved by<br>plant parents.";
    ViewData["PromoSub"] = "Our best sellers are chosen by thousands of happy customers!";
    ViewData["PromoCta"] = "Shop Now →";
}

<div class="page-banner">
    <div class="page-banner-bg"></div>
    <div class="page-banner-bg" style="background-image: url('/images/best_sellerss.png');"></div>
    <div class="page-banner-text">
        <h2>Best Sellers</h2>
        <p>Discover the most-loved plants<br>chosen by our community.</p>
        <a href="#" class="btn btn-plant">Explore Best Sellers</a>
    </div>
</div>

<div class="section-header mt-2">
    <h4>All Best Sellers</h4>
    <div class="filter-sort">
        <span>Sort by:</span>
        <select class="sort-select">
            <option>Bestselling</option>
            <option>Price: Low to High</option>
            <option>Price: High to Low</option>
            <option>Top Rated</option>
        </select>
    </div>
</div>

<div class="row g-3">
    @foreach (var item in Model)
    {
        <div class="col-6 col-md-4 col-xl-2half">
            <div class="g-card">
                <div class="g-img-wrap">
                    <img src="@item.ImageUrl" alt="@item.Name" class="g-img" />
                    <button class="g-wish-btn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    </button>
                </div>
                <div class="g-info">
                    <div class="g-name">@item.Name</div>
                    <div class="g-sub">@item.Category</div>
                    <div class="g-rating">
                        <span class="g-stars">★★★★★</span>
                        <span>4.9 (1.2k)</span>
                    </div>
                    <div class="g-price-row">
                        <span class="g-price">₱@item.Price.ToString("N0")</span>
                        <button class="g-cart-btn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>