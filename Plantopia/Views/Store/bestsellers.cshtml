@model List<Plantopia.Models.Plant>

@{
    Layout = "_SideTopBar";
    ViewData["Title"] = "Best Sellers — Plantopia";
    ViewData["PromoTitle"] = "Loved by<br>plant parents.";
    ViewData["PromoSub"] = "Our best sellers are chosen by thousands of happy customers!";
    ViewData["PromoCta"] = "Shop Now →";

    var wishlistedIds = ViewData["WishlistedIds"] as List<int> ?? new List<int>();
}

<div class="page-banner">
    <div class="page-banner-bg"></div>
    <div class="page-banner-bg" style="background-image: url('/images/background/best_sellerss.png');"></div>
    <div class="page-banner-text">
        <h2>Best Sellers</h2>
        <p>Discover the most-loved plants<br>chosen by our community.</p>
        <a href="#" class="btn btn-plant">Explore Best Sellers</a>
    </div>
</div>

<div class="section-header mt-2">
    <h4>All Best Sellers</h4>
    <div class="filter-sort">
        <span>Sort by:</span>
        <select class="sort-select" onchange="sortPage(this.value)">
            <option value="bestselling">Bestselling</option>
            <option value="price_asc">Price: Low to High</option>
            <option value="price_desc">Price: High to Low</option>
            <option value="top_rated">Top Rated</option>
        </select>
    </div>
</div>

<div class="row g-3">
    @foreach (var item in Model)
    {
        var isWishlisted = wishlistedIds.Contains(item.Id);
        <div class="col-6 col-md-4 col-xl-2half">
            <div class="g-card" style="cursor:pointer;"
                 onclick="openPlantModal(@item.Id, '@item.Name', '@item.Category', '@item.Price', '@item.ImageUrl', '@item.Description')">
                <div class="g-img-wrap">
                    <img src="@item.ImageUrl" alt="@item.Name" class="g-img" />
                    <button class="g-wish-btn wishlist-btn @(isWishlisted ? "wishlisted" : "")"
                            data-plant-id="@item.Id"
                            onclick="event.stopPropagation()">
                        <svg width="14" height="14" viewBox="0 0 24 24"
                             fill="@(isWishlisted ? "currentColor" : "none")"
                             stroke="currentColor" stroke-width="2.2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                        </svg>
                    </button>
                </div>
                <div class="g-info">
                    <div class="g-name">@item.Name</div>
                    <div class="g-sub">@item.Category</div>
                    <div class="g-rating">
                        <span class="g-stars">★★★★★</span>
                        <span>@item.Rating</span>
                    </div>
                    <div class="g-price-row">
                        <span class="g-price">₱@item.Price.ToString("N0")</span>
                        <button class="g-cart-btn"
                                onclick="event.stopPropagation(); addToCartDirect(@item.Id, this)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <circle cx="9" cy="21" r="1" />
                                <circle cx="20" cy="21" r="1" />
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- ══ PLANT MODAL ══ -->
<div id="plantModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:9999; align-items:center; justify-content:center; padding:20px;">
    <div id="pm-box" style="background:#fff; border-radius:18px; width:100%; max-width:960px; max-height:92vh; position:relative; font-family:'Segoe UI',sans-serif; display:flex; flex-direction:column; overflow:hidden;">

        <div style="display:flex; gap:20px; padding:22px 22px 0 22px; flex-shrink:0;">

            <div style="display:flex; flex-direction:column; gap:7px; flex-shrink:0;">
                <div class="pm-thumb pm-thumb-active" onclick="switchThumb(this)" style="width:68px; height:68px; border-radius:10px; border:2px solid #1a3a1a; overflow:hidden; cursor:pointer; background:#f5f5f3;">
                    <img id="pm-thumb-0" src="" style="width:100%; height:100%; object-fit:cover;" />
                </div>
                <div class="pm-thumb" onclick="switchThumb(this)" style="width:68px; height:68px; border-radius:10px; border:2px solid #e8e8e8; overflow:hidden; cursor:pointer; background:#f5f5f3;">
                    <img id="pm-thumb-1" src="" style="width:100%; height:100%; object-fit:cover;" />
                </div>
                <div class="pm-thumb" onclick="switchThumb(this)" style="width:68px; height:68px; border-radius:10px; border:2px solid #e8e8e8; overflow:hidden; cursor:pointer; background:#f5f5f3;">
                    <img id="pm-thumb-2" src="" style="width:100%; height:100%; object-fit:cover;" />
                </div>
                <div class="pm-thumb" onclick="switchThumb(this)" style="width:68px; height:68px; border-radius:10px; border:2px solid #e8e8e8; overflow:hidden; cursor:pointer; background:#f5f5f3;">
                    <img id="pm-thumb-3" src="" style="width:100%; height:100%; object-fit:cover;" />
                </div>
            </div>
 
            <div style="width:300px; height:300px; border-radius:16px; background:#f5f5f3; overflow:hidden; position:relative; flex-shrink:0;">
                <img id="pm-main-img" src="" style="width:100%; height:100%; object-fit:cover;" />
                <button id="modal-wish-btn" onclick="toggleModalWishlist()" style="position:absolute; top:12px; right:12px; background:rgba(255,255,255,0.92); border:none; border-radius:50%; width:34px; height:34px; display:flex; align-items:center; justify-content:center; cursor:pointer; color:#bbb; transition:color 0.2s;">
                    <svg id="modal-wish-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                </button>
            </div>
 
            <div style="flex:1; min-width:0; padding-top:2px;">
                <button onclick="closePlantModal()" style="position:absolute; top:14px; right:14px; background:none; border:1.5px solid #ddd; border-radius:50%; width:30px; height:30px; font-size:14px; cursor:pointer; color:#666; display:flex; align-items:center; justify-content:center;">✕</button>
 
                <div id="pm-name" style="font-size:1.5rem; font-weight:700; color:#111; margin-bottom:2px; font-family:'Georgia',serif;"></div>
                <div style="font-size:0.78rem; color:#999; margin-bottom:5px;">By Green Haven PH</div>
                <div style="display:flex; align-items:center; gap:5px; margin-bottom:10px;">
                    <span style="color:#2e7d32; font-size:14px;">★</span>
                    <span style="font-size:0.8rem; color:#444;">4.9 (1.2k reviews)</span>
                </div>
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
                    <span id="pm-price" style="font-size:1.6rem; font-weight:700; color:#111;"></span>
                    <span id="pm-orig-price" style="font-size:0.9rem; color:#bbb; text-decoration:line-through;"></span>
                    <span style="background:#e53935; color:#fff; font-size:0.68rem; font-weight:700; padding:2px 8px; border-radius:5px;">-20%</span>
                </div>
 
                <div id="pm-desc" style="font-size:0.83rem; color:#555; line-height:1.5; margin-bottom:9px;"></div>
 
                <div style="display:flex; gap:18px; margin-bottom:10px;">
                    <div style="display:flex; align-items:center; gap:6px; font-size:0.77rem; color:#555;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.8"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /></svg>
                        Bright, Indirect Light
                    </div>
                    <div style="display:flex; align-items:center; gap:6px; font-size:0.77rem; color:#555;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.8"><path d="M12 2C6 9 4 13 4 16a8 8 0 0016 0c0-3-2-7-8-14z" /></svg>
                        Water 1-2 times per week
                    </div>
                </div>
 
                <div style="border-top:1px solid #efefef; margin-bottom:10px;"></div>
 
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
                    <span style="font-size:0.82rem; color:#555;">Quantity:</span>
                    <div style="display:flex; align-items:center; border:1.5px solid #ddd; border-radius:9px; overflow:hidden;">
                        <button onclick="changeQty(-1)" style="width:34px; height:34px; border:none; background:#fff; font-size:18px; cursor:pointer; color:#333;">−</button>
                        <span id="pm-qty" style="width:32px; text-align:center; font-size:0.9rem; font-weight:600;">1</span>
                        <button onclick="changeQty(1)" style="width:34px; height:34px; border:none; background:#fff; font-size:18px; cursor:pointer; color:#333;">+</button>
                    </div>
                    <button onclick="addToCartFromModal()" style="flex:1; background:#3a7d44; color:#fff; border:none; border-radius:11px; padding:9px 0; font-size:0.84rem; font-weight:600; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:7px;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 01-8 0" /></svg>
                        Add to Cart
                    </button>
                </div>
 
                <div style="display:flex; gap:8px; margin-bottom:10px;">
                    <button onclick="buyNowFromModal()" style="flex:1; background:#fff; color:#1a1a1a; border:1.5px solid #ccc; border-radius:11px; padding:8px 0; font-size:0.84rem; font-weight:600; cursor:pointer;">
                        Buy Now
                    </button>
                    <a href="/Account/Cart" style="flex:1; background:#f0f4f0; color:#1a3a1a; border:1.5px solid #d0e0d0; border-radius:11px; padding:8px 0; font-size:0.84rem; font-weight:600; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:6px; text-decoration:none;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="9" cy="21" r="1" />
                            <circle cx="20" cy="21" r="1" />
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                        </svg>
                        View Cart
                    </a>
                </div>
 
                <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:6px;">
                    <div style="display:flex; align-items:center; gap:7px;">
                        <div style="width:34px; height:34px; border-radius:50%; background:#f0f4f0; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="1.8"><rect x="1" y="3" width="15" height="13" rx="2" /><path d="M16 8h4l3 5v3h-7V8z" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                        </div>
                        <div>
                            <div style="font-size:0.66rem; font-weight:600; color:#1a3a1a; line-height:1.3;">Fast & Safe Delivery</div>
                            <div style="font-size:0.6rem; color:#999;">3-5 business days</div>
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:7px;">
                        <div style="width:34px; height:34px; border-radius:50%; background:#f0f4f0; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="1.8"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg>
                        </div>
                        <div>
                            <div style="font-size:0.66rem; font-weight:600; color:#1a3a1a; line-height:1.3;">Secure Packaging</div>
                            <div style="font-size:0.6rem; color:#999;">Plants arrive in perfect condition</div>
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:7px;">
                        <div style="width:34px; height:34px; border-radius:50%; background:#f0f4f0; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                        </div>
                        <div>
                            <div style="font-size:0.66rem; font-weight:600; color:#1a3a1a; line-height:1.3;">Plant Parent Support</div>
                            <div style="font-size:0.6rem; color:#999;">We're here to help!</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
 
        <!-- TABS -->
        <div style="display:flex; border-bottom:1.5px solid #eee; margin:10px 22px 0 22px; flex-shrink:0;">
            <button class="pm-tab pm-tab-active" onclick="switchTab(this,'pm-tab-desc')" style="padding:9px 16px; font-size:0.83rem; font-weight:700; color:#1a3a1a; background:none; border:none; cursor:pointer; border-bottom:2.5px solid #1a3a1a; margin-bottom:-1.5px;">Description</button>
            <button class="pm-tab" onclick="switchTab(this,'pm-tab-care')" style="padding:9px 16px; font-size:0.83rem; font-weight:500; color:#999; background:none; border:none; cursor:pointer; border-bottom:2.5px solid transparent; margin-bottom:-1.5px;">Care Guide</button>
            <button class="pm-tab" onclick="switchTab(this,'pm-tab-spec')" style="padding:9px 16px; font-size:0.83rem; font-weight:500; color:#999; background:none; border:none; cursor:pointer; border-bottom:2.5px solid transparent; margin-bottom:-1.5px;">Specifications</button>
            <button class="pm-tab" onclick="switchTab(this,'pm-tab-rev')" style="padding:9px 16px; font-size:0.83rem; font-weight:500; color:#999; background:none; border:none; cursor:pointer; border-bottom:2.5px solid transparent; margin-bottom:-1.5px;">Reviews (1.2k)</button>
        </div>
 
        <!-- TAB CONTENTS -->
        <div style="padding:14px 22px 18px 22px; flex:1; overflow-y:auto; min-height:0;">

 
            <div id="pm-tab-desc" style="display:flex; gap:16px; height:100%; align-items:flex-start;">
                <div style="flex:1; min-width:0;">
                    <p id="pm-full-desc" style="font-size:0.83rem; color:#444; line-height:1.7; margin-bottom:6px;"></p>
                    <p style="font-size:0.74rem; color:#bbb; margin:0;">Note: Plant size may vary. Pot not included.</p>
                </div>
                <div style="width:220px; flex-shrink:0;">
                    <table style="width:100%; font-size:0.8rem; border-collapse:collapse;">
                        <tr style="border-bottom:1px solid #f0f0f0;">
                            <td style="padding:8px 6px; color:#888; white-space:nowrap;">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2" style="vertical-align:middle; margin-right:5px;"><path d="M12 2C8 7 5 11 5 15a7 7 0 0014 0c0-4-3-8-7-13z" /></svg>Plant Type
                            </td>
                            <td style="padding:8px 6px; font-weight:500; color:#1a1a1a; text-align:right;" id="pm-spec-type"></td>
                        </tr>
                        <tr style="border-bottom:1px solid #f0f0f0;">
                            <td style="padding:8px 6px; color:#888; white-space:nowrap;">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2" style="vertical-align:middle; margin-right:5px;"><line x1="12" y1="20" x2="12" y2="10" /><line x1="18" y1="20" x2="18" y2="4" /><line x1="6" y1="20" x2="6" y2="16" /></svg>Mature Height
                            </td>
                            <td style="padding:8px 6px; font-weight:500; color:#1a1a1a; text-align:right;">1.5 - 2.5 ft</td>
                        </tr>
                        <tr style="border-bottom:1px solid #f0f0f0;">
                            <td style="padding:8px 6px; color:#888; white-space:nowrap;">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2" style="vertical-align:middle; margin-right:5px;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>Pet Friendly
                            </td>
                            <td style="padding:8px 6px; font-weight:500; color:#1a1a1a; text-align:right;">No</td>
                        </tr>
                        <tr>
                            <td style="padding:8px 6px; color:#888; white-space:nowrap;">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2" style="vertical-align:middle; margin-right:5px;"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>Air Purifying
                            </td>
                            <td style="padding:8px 6px; font-weight:500; color:#1a1a1a; text-align:right;">Yes</td>
                        </tr>
                    </table>
                </div>
            </div>

 
            <div id="pm-tab-care" style="display:none; padding:10px 22px; overflow:hidden;">


                <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px; padding-bottom:10px; border-bottom:1px solid #eee;">
                    <img id="pm-care-thumb" src="" style="width:52px; height:52px; border-radius:10px; object-fit:cover; background:#f0f0f0; flex-shrink:0;" />
                    <div>
                        <div id="pm-care-name" style="font-size:0.95rem; font-weight:700; color:#111; font-family:'Georgia',serif;"></div>
                        <div style="font-size:0.72rem; color:#888; margin-top:1px;">By Green Haven PH</div>
                        <div style="font-size:0.72rem; color:#2e7d32; margin-top:1px;">★ 4.9 <span style="color:#888;">(1.2k reviews)</span></div>
                    </div>
                </div>


                <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:6px; margin-bottom:6px;">

                    <div style="background:#f9fbf9; border-radius:10px; overflow:hidden; border:1px solid #eef2ee; display:flex; flex-direction:column;">
                        <div style="padding:8px 10px 6px; flex:1;">
                            <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                                <div style="width:26px; height:26px; border-radius:50%; background:#eef5ee; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <span style="font-size:12px;">☀️</span>
                                </div>
                                <span style="font-size:0.78rem; font-weight:700; color:#1a3a1a;">Light</span>
                            </div>
                            <div style="font-size:0.7rem; color:#555; line-height:1.5;">Bright, indirect light. Avoid direct sunlight.</div>
                        </div>
                        <div style="height:65px; background:linear-gradient(135deg,#e8f0e8,#d0e4d0); overflow:hidden; flex-shrink:0;">
                            <img id="pm-care-img-light" src="" style="width:100%;height:100%;object-fit:cover;" />
                        </div>
                    </div>


                    <div style="background:#f9fbf9; border-radius:10px; overflow:hidden; border:1px solid #eef2ee; display:flex; flex-direction:column;">
                        <div style="padding:8px 10px 6px; flex:1;">
                            <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                                <div style="width:26px; height:26px; border-radius:50%; background:#eef5ee; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <span style="font-size:12px;">💧</span>
                                </div>
                                <span style="font-size:0.78rem; font-weight:700; color:#1a3a1a;">Watering</span>
                            </div>
                            <div style="font-size:0.7rem; color:#555; line-height:1.5;">Water 1-2 times per week. Allow soil to dry slightly between waterings.</div>
                        </div>
                        <div style="height:65px; background:linear-gradient(135deg,#e0eef5,#c8dfe8); overflow:hidden; flex-shrink:0;">
                            <img id="pm-care-img-water" src="" style="width:100%;height:100%;object-fit:cover;" />
                        </div>
                    </div>

                    <div style="background:#f9fbf9; border-radius:10px; overflow:hidden; border:1px solid #eef2ee; display:flex; flex-direction:column;">
                        <div style="padding:8px 10px 6px; flex:1;">
                            <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                                <div style="width:26px; height:26px; border-radius:50%; background:#eef5ee; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <span style="font-size:12px;">🌱</span>
                                </div>
                                <span style="font-size:0.78rem; font-weight:700; color:#1a3a1a;">Soil</span>
                            </div>
                            <div style="font-size:0.7rem; color:#555; line-height:1.5;">Use well-draining potting mix. Aroid or tropical plant mix is ideal.</div>
                        </div>
                        <div style="height:65px; background:linear-gradient(135deg,#ede8e0,#d8cfc0); overflow:hidden; flex-shrink:0;">
                            <img id="pm-care-img-soil" src="" style="width:100%;height:100%;object-fit:cover;" />
                        </div>
                    </div>

                    <div style="background:#f9fbf9; border-radius:10px; overflow:hidden; border:1px solid #eef2ee; display:flex; flex-direction:column;">
                        <div style="padding:8px 10px 6px; flex:1;">
                            <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                                <div style="width:26px; height:26px; border-radius:50%; background:#eef5ee; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <span style="font-size:12px;">🌡️</span>
                                </div>
