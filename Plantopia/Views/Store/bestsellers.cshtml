                        <img src="/images/profiles/farmer-tomas.png" style="width:38px; height:38px; border-radius:50%; object-fit:cover; flex-shrink:0;" onerror="this.style.display='none'" />
                        <div style="flex:1; min-width:0;">
                            <div style="display:flex; align-items:center; gap:8px; margin-bottom:2px; flex-wrap:wrap;">
                                <span style="font-size:0.85rem; font-weight:600; color:#1a1a1a;">Jessie P.</span>
                                <span style="background:#e8f5e9; color:#2e7d32; font-size:0.65rem; font-weight:600; padding:2px 7px; border-radius:4px;">Verified Buyer</span>
                                <span style="font-size:0.72rem; color:#bbb; margin-left:auto;">May 8, 2025</span>
                                <span style="color:#888; font-size:1rem; cursor:pointer; margin-left:4px;">···</span>
                            </div>
                            <div style="color:#2e7d32; font-size:12px; margin-bottom:3px;">★★★★★</div>
                            <div style="font-size:0.82rem; font-weight:600; color:#1a1a1a; margin-bottom:2px;">Love it!</div>
                            <div style="font-size:0.78rem; color:#555; line-height:1.5;">It instantly elevated the look of my space. Easy to care for too!</div>
                            <div style="display:flex; align-items:center; gap:10px; margin-top:5px; font-size:0.72rem; color:#888;">
                                Was this review helpful?
                                <span style="cursor:pointer;">👍 5</span>
                                <span style="cursor:pointer;">👎 0</span>
                            </div>
                        </div>
                        <div style="width:70px; height:70px; border-radius:10px; overflow:hidden; flex-shrink:0; background:#c8dcc8;">
                            <img id="pm-rev-r3" src="" style="width:100%;height:100%;object-fit:cover;" />
                        </div>
                    </div>

                </div>
            </div>
 
        </div>
    </div>
</div>

@section Scripts {
    <script>

                var wishlistedIds = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                            ViewData["WishlistedIds"] as List<int> ?? new List<int>()
                    )
            )

        function addToCartDirect(plantId, btn) {
            btn.disabled = true;
            btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>`;

            fetch('/Account/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `plantId=${plantId}&quantity=1`
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success && data.redirect) {
                    window.location.href = data.redirect;
                    return;
                }
                document.querySelectorAll('.cart-count-badge').forEach(el => {
                    el.textContent = data.cartCount;
                    el.style.display = data.cartCount > 0 ? 'inline-flex' : 'none';
                });
                setTimeout(() => {
                    btn.disabled = false;
                    btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`;
                }, 1500);
            })
            .catch(() => { btn.disabled = false; });
        }



        function sortPage(value) {
            var url = new URL(window.location.href);
            url.searchParams.set('sort', value);
            window.location.href = url.toString();
        }

        document.addEventListener('DOMContentLoaded', function () {
            var params = new URLSearchParams(window.location.search);
            var current = params.get('sort');
            if (current) {
                var select = document.querySelector('.sort-select');
                if (select) select.value = current;
            }
        });

        document.querySelectorAll('.wishlist-btn').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                const plantId = this.dataset.plantId;
                fetch('/Account/ToggleWishlist', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `plantId=${plantId}`
                })
                .then(res => res.json())
                .then(data => {
                    if (!data.success) { window.location.href = '/Auth/Login'; return; }
                    const svg = this.querySelector('svg');
                            if (data.wishlisted) {
            this.classList.add('wishlisted');
            if (svg) svg.setAttribute('fill', 'currentColor');
        } else {
            this.classList.remove('wishlisted');
            if (svg) svg.setAttribute('fill', 'none');
        }

        var id = parseInt(plantId);
        if (data.wishlisted) {
            if (!wishlistedIds.includes(id)) wishlistedIds.push(id);
        } else {
            wishlistedIds = wishlistedIds.filter(x => x !== id);
        }

        if (currentPlantId && parseInt(currentPlantId) === id) {
                    updateModalWishBtn(data.wishlisted);
                }
                });
            });
        });

        let currentPlantId = null;

        function openPlantModal(plantId, name, category, price, imageUrl, description) {
            currentPlantId = plantId;

            document.getElementById('pm-name').textContent = name;
            document.getElementById('pm-full-desc').textContent = description || 'A beautiful plant perfect for your home.';
            document.getElementById('pm-desc').textContent = description || 'A beautiful plant perfect for your home.';

            var numPrice = parseFloat(price);
            var origPrice = Math.round(numPrice * 1.25);
            document.getElementById('pm-price').textContent = '₱' + numPrice.toLocaleString();
            document.getElementById('pm-orig-price').textContent = '₱' + origPrice.toLocaleString();

            document.getElementById('pm-spec-type').textContent = category || 'Tropical';
            document.getElementById('pm-spec2-type').textContent = category || 'Tropical';
            document.getElementById('pm-care-name').textContent = name;
            document.getElementById('pm-care-thumb').src = imageUrl;
            document.getElementById('pm-spec-name').textContent = name;
            document.getElementById('pm-spec-thumb').src = imageUrl;
            document.getElementById('pm-rev-header-thumb').src = imageUrl;
            document.getElementById('pm-rev-header-name').textContent = name;
            document.getElementById('pm-rev-img1').src = '/images/Monstera Deliciosa.png';
            document.getElementById('pm-rev-img2').src = '/images/Peace Lily.png';
            document.getElementById('pm-rev-img3').src = '/images/Golden Pothos.png';
            document.getElementById('pm-rev-r1').src = '/images/Monstera Deliciosa.png';
            document.getElementById('pm-rev-r2').src = '/images/Peace Lily.png';
            document.getElementById('pm-rev-r3').src = '/images/Jade Plant.png';

              var careImages = {
             'pm-care-img-light': '/images/Light1_modal.png',
             'pm-care-img-water': '/images/Watering_modal.png',
             'pm-care-img-soil':  '/images/Soil_modal.png',
             'pm-care-img-temp':  '/images/Temperature_modal.png',
             'pm-care-img-hum':   '/images/Humidity_modal.png',
             'pm-care-img-fert':  '/images/Fertilizing_modal.png',
             'pm-care-img-tips':  '/images/Plants_Display.png'
         };
            Object.entries(careImages).forEach(function([id, src]) {
                var el = document.getElementById(id);
                if (el) el.src = src;
            });

            document.getElementById('pm-main-img').src = imageUrl;
            for (var i = 0; i < 4; i++) {
                var thumb = document.getElementById('pm-thumb-' + i);
                if (thumb) thumb.src = imageUrl;
            }

            var isWishlisted = wishlistedIds.includes(parseInt(plantId));
            updateModalWishBtn(isWishlisted);
            document.getElementById('pm-qty').textContent = '1';
            document.getElementById('plantModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
            switchTab(document.querySelector('.pm-tab'), 'pm-tab-desc');
        }

        function closePlantModal() {
            document.getElementById('plantModal').style.display = 'none';
            document.body.style.overflow = '';
            currentPlantId = null;
            var topSection = document.querySelector('#pm-box > div:first-child');
            if (topSection) topSection.style.display = 'flex';
        }

        function changeQty(delta) {
            var el = document.getElementById('pm-qty');
            var val = parseInt(el.textContent) + delta;
            if (val < 1) val = 1;
            el.textContent = val;
        }

        function addToCartFromModal() {
            if (!currentPlantId) return;
            var qty = parseInt(document.getElementById('pm-qty').textContent) || 1;
            var btn = document.querySelector('button[onclick="addToCartFromModal()"]');

            btn.disabled = true;
            btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Adding...`;

            fetch('/Account/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `plantId=${currentPlantId}&quantity=${qty}`
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    if (data.redirect) { window.location.href = data.redirect; return; }
                    btn.disabled = false;
                    btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg> Add to Cart`;
                    return;
                }
                var badge = document.querySelector('.cart-count-badge');
                if (badge) badge.textContent = data.cartCount;

                btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Added!`;
                btn.style.background = '#2e7d32';
                setTimeout(() => {
                    btn.disabled = false;
                    btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg> Add to Cart`;
                    btn.style.background = '#3a7d44';
                }, 2000);
            })
            .catch(() => {
                btn.disabled = false;
                btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg> Add to Cart`;
            });
        }

        function buyNowFromModal() {
            if (!currentPlantId) return;
            var qty = parseInt(document.getElementById('pm-qty').textContent) || 1;
            var btn = document.querySelector('button[onclick="buyNowFromModal()"]');
            btn.disabled = true;
            btn.textContent = 'Processing...';

            fetch('/Account/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `plantId=${currentPlantId}&quantity=${qty}`
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success && data.redirect) {
                    window.location.href = data.redirect;
                    return;
                }
                window.location.href = '/Account/Cart';
            })
            .catch(() => {
                btn.disabled = false;
                btn.textContent = 'Buy Now';
            });
        }

        function switchTab(btn, tabId) {
            var topSection = document.querySelector('#pm-box > div:first-child');
            if (topSection) {
                topSection.style.display = (tabId === 'pm-tab-care' || tabId === 'pm-tab-spec' || tabId === 'pm-tab-rev') ? 'none' : 'flex';
            }
            document.querySelectorAll('.pm-tab').forEach(function(t) {
                t.style.color = '#888'; t.style.fontWeight = '500';
                t.style.borderBottom = '2.5px solid transparent';
                t.classList.remove('pm-tab-active');
            });
            btn.style.color = '#2e7d32'; btn.style.fontWeight = '600';
            btn.style.borderBottom = '2.5px solid #2e7d32';
            btn.classList.add('pm-tab-active');
            ['pm-tab-desc','pm-tab-care','pm-tab-spec','pm-tab-rev'].forEach(function(id) {
                var el = document.getElementById(id);
                if (el) el.style.display = 'none';
            });
            var active = document.getElementById(tabId);
            if (active) active.style.display = tabId === 'pm-tab-desc' ? 'flex' : 'block';
        }

        function switchThumb(thumbEl) {
            document.querySelectorAll('.pm-thumb').forEach(function(t) {
                t.style.border = '2px solid #e8e8e8';
            });
            thumbEl.style.border = '2px solid #2e7d32';
            var img = thumbEl.querySelector('img');
            if (img) document.getElementById('pm-main-img').src = img.src;
        }

        document.getElementById('plantModal').addEventListener('click', function(e) {
            if (e.target === this) closePlantModal();
        });
        function updateModalWishBtn(wishlisted) {
                var btn = document.getElementById('modal-wish-btn');
                var svg = document.getElementById('modal-wish-svg');
                if (!btn || !svg) return;
                svg.setAttribute('fill', wishlisted ? '#e53935' : 'none');
                svg.setAttribute('stroke', wishlisted ? '#e53935' : 'currentColor');
                btn.style.color = wishlisted ? '#e53935' : '#bbb';
            }

            function toggleModalWishlist() {
                if (!currentPlantId) return;
                fetch('/Account/ToggleWishlist', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `plantId=${currentPlantId}`
                })
                .then(res => res.json())
                .then(data => {
                    if (!data.success) { window.location.href = '/Auth/Login'; return; }
                    updateModalWishBtn(data.wishlisted);
                    var id = parseInt(currentPlantId);
                    if (data.wishlisted) {
                        if (!wishlistedIds.includes(id)) wishlistedIds.push(id);
                    } else {
                        wishlistedIds = wishlistedIds.filter(function(x) { return x !== id; });
                    }
                    var cardBtn = document.querySelector('.wishlist-btn[data-plant-id="' + currentPlantId + '"]');
                    if (cardBtn) {
                        var cardSvg = cardBtn.querySelector('svg');
                        if (data.wishlisted) { cardBtn.classList.add('wishlisted'); if (cardSvg) cardSvg.setAttribute('fill', 'currentColor'); }
                        else { cardBtn.classList.remove('wishlisted'); if (cardSvg) cardSvg.setAttribute('fill', 'none'); }
                    }
                });
            }
    </script>
}