<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Plantopia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/plantopia.css" />
    @RenderSection("Styles", required: false)
</head>
<body>

    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        string IsActive(string ctrl, string act = "Index") =>
            currentController == ctrl && currentAction == act ? "active" : "";

        var loggedInUser = Context.Session.GetString("UserEmail");
    }

    <nav class="plantopia-nav navbar navbar-expand-lg fixed-top" id="mainNavbar">
        <div class="container">

            <a class="navbar-brand plant-brand" asp-controller="Home" asp-action="Index">
                <img src="/images/plant.png" alt="Plantopia" class="nav-logo-img" />
                Plantopia
            </a>

            <button class="navbar-toggler border-0" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navMenu"
                    aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav mx-auto gap-1 gap-lg-3">
                    <li class="nav-item">
                        <a class="nav-link nav-spy @IsActive("Home")" data-section="hero"
                           asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-spy @IsActive("Home", "About")" data-section="about"
                           asp-controller="Home" asp-action="About">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-spy @IsActive("Home", "Services")" data-section="sellers"
                           asp-controller="Home" asp-action="Services">Sellers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @IsActive("Home", "Contact")"
                           asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    @if (!string.IsNullOrEmpty(loggedInUser))
                    {
                        <span class="nav-user d-none d-lg-inline">👤 @loggedInUser</span>
                        <a class="btn btn-outline-plant btn-sm" asp-controller="Auth" asp-action="Logout">Logout</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-plant btn-sm" asp-controller="Auth" asp-action="Login">Login</a>
                        <a class="btn btn-plant btn-sm" asp-controller="Auth" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="flash-msg flash-success" id="flashMsg">✅ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="flash-msg flash-error" id="flashMsg">❌ @TempData["Error"]</div>
    }

    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const navbar = document.getElementById('mainNavbar');
        window.addEventListener('scroll', () => {
        navbar.classList.toggle('scrolled', window.scrollY > 40);
        });
        setTimeout(() => {
        const flash = document.getElementById('flashMsg');
        if (flash) { flash.style.transition = 'opacity 0.6s'; flash.style.opacity = '0'; }
        }, 3000);
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
