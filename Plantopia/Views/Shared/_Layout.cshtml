<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Plantopia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/plantopia.css" />
</head>
<body>

    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        string IsActive(string ctrl, string act = "Index") =>
        currentController == ctrl && currentAction == act ? "active" : "";

        var loggedInUser = Context.Session.GetString("UserEmail");
    }

    <nav class="plantopia-nav navbar navbar-expand-lg fixed-top" id="mainNavbar">
        <div class="container">

            <a class="navbar-brand plant-brand" asp-controller="Home" asp-action="Index">
                <img src="/images/plant.png" alt="Plantopia" class="nav-logo-img" />
                Plantopia
            </a>

            <button class="navbar-toggler border-0" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navMenu"
                    aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav mx-auto gap-1 gap-lg-3">
                    <li class="nav-item">
                        <a class="nav-link nav-spy @IsActive("Home")" data-section="hero"
                           asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-spy @IsActive("Home", "About")" data-section="about"
                           asp-controller="Home" asp-action="About">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-spy @IsActive("Home", "Services")" data-section="sellers"
                           asp-controller="Home" asp-action="Services">Sellers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @IsActive("Home", "Contact")"
                           asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    @if (!string.IsNullOrEmpty(loggedInUser))
                    {
                        <span class="nav-user d-none d-lg-inline">👤 @loggedInUser</span>
                        <a class="btn btn-outline-plant btn-sm" asp-controller="Auth" asp-action="Logout">Logout</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-plant btn-sm" asp-controller="Auth" asp-action="Login">Login</a>
                        <a class="btn btn-plant btn-sm" asp-controller="Auth" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="flash-msg flash-success" id="flashMsg">✅ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="flash-msg flash-error" id="flashMsg">❌ @TempData["Error"]</div>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="plant-footer">
        <div class="container">
            <div class="row g-4 align-items-start">

                <div class="col-lg-4 col-md-12 mb-2">
                    <div class="footer-brand">
                        <span class="footer-brand-name">🌿 Plantopia</span>
                        <p class="footer-tagline">
                            Homegrown, heart-grown, Cebu-grown.<br />
                            Supporting local farmers, one plant at a time. 🇵🇭
                        </p>
                        <div class="footer-socials">
                            <a href="#" class="footer-social-btn" aria-label="Facebook">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                                </svg>
                            </a>
                            <a href="#" class="footer-social-btn" aria-label="Instagram">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                                    <circle cx="12" cy="12" r="4" />
                                    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                                </svg>
                            </a>
                            <a href="#" class="footer-social-btn" aria-label="X / Twitter">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622Zm-1.161 17.52h1.833L7.084 4.126H5.117Z" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="footer-heading">SHOP</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Shop" asp-action="Index">All Plants</a></li>
                        <li><a asp-controller="Shop" asp-action="Index" asp-route-category="Indoor Plants">Indoor Plants</a></li>
                        <li><a asp-controller="Shop" asp-action="Index" asp-route-category="Outdoor Plants">Outdoor Plants</a></li>
                        <li><a asp-controller="Shop" asp-action="Index" asp-route-category="Balcony / Patio">Balcony / Patio</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="footer-heading">COMPANY</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Services">Our Farmers</a></li>
                        <li><a href="#">Blog</a></li>
                        <li><a href="#">Careers</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="footer-heading">STAY IN THE LOOP</h6>
                    <p class="footer-newsletter-text">Get plant care tips & new arrivals straight to your inbox.</p>
                    <div class="footer-newsletter">
                        <input type="email" class="footer-newsletter-input" placeholder="your@email.com" />
                        <button class="footer-newsletter-btn">→</button>
                    </div>
                    <ul class="footer-links mt-3">
                        <li>📍 Cebu City, PH</li>
                        <li>📞 0917-PLANTOPIA</li>
                        <li>✉️ hello@plantopia.ph</li>
                    </ul>
                </div>

            </div>

            <div class="footer-bottom">
                <p>© @DateTime.Now.Year Plantopia. All rights reserved. Made with 💚 in Cebu.</p>
                <p>Privacy Policy · Terms of Use</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const navbar = document.getElementById('mainNavbar');
        window.addEventListener('scroll', () => {
            navbar.classList.toggle('scrolled', window.scrollY > 40);
        });
        setTimeout(() => {
            const flash = document.getElementById('flashMsg');
            if (flash) { flash.style.transition = 'opacity 0.6s'; flash.style.opacity = '0'; }
        }, 3000);
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
