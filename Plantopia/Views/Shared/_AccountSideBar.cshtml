@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    string AccountActive(string action) =>
        currentController == "Account" && currentAction == action ? "active" : "";

    var userName = Context.Session.GetString("UserName") ?? "Guest";
    var userEmail = Context.Session.GetString("UserEmail") ?? "";
    var firstName = userName.Split(' ')[0];
    var initials = string.IsNullOrEmpty(userName) ? "?" :
        string.Join("", userName.Split(' ')
        .Where(w => w.Length > 0)
        .Select(w => w[0]))
        .ToUpper();

    var profilePhoto = "";
    if (!string.IsNullOrEmpty(userEmail))
    {
        var dbContext = Context.RequestServices.GetService<Plantopia.Data.AppDbContext>();
        var currentUser = dbContext?.Users.FirstOrDefault(u => u.Email == userEmail);
        profilePhoto = currentUser?.ProfilePhoto ?? "";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Plantopia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/account-layout.css" />
    <link rel="stylesheet" href="~/css/user-dropdown.css" />
    @RenderSection("Styles", required: false)
</head>
<body>

    @* ════════════════════════════════════════════
   STRUCTURE:
   [SIDEBAR full height left] + [RIGHT SIDE: topbar + main content]
   Same as _SideTopBar.cshtml
   ════════════════════════════════════════════ *@
    <div class="account-page-wrapper">

        @* ── SIDEBAR (fixed, full height, LEFT) ── *@
        <aside class="account-sidebar">

            <div class="account-sidebar-user">
                <div class="account-sidebar-avatar">
                    @if (!string.IsNullOrEmpty(profilePhoto))
                    {
                        <img src="@profilePhoto" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" alt="avatar" />
                    }
                    else
                    {
                        <img src="~/images/avatar-placeholder.png" alt="User Avatar"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="account-sidebar-avatar-fallback" style="display:none;">@initials</div>
                    }
                </div>
                <div class="account-sidebar-userinfo">
                    <div class="account-sidebar-name">@userName</div>
                    <div class="account-sidebar-email">@userEmail</div>
                </div>
                <div class="account-sidebar-leaf">🌿</div>
            </div>

            <nav class="account-sidebar-nav">
                <a asp-controller="Account" asp-action="Profile"
                       class="account-nav-item @AccountActive("Profile")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    My Profile
                </a>
                <a asp-controller="Account" asp-action="Purchases"
                       class="account-nav-item @AccountActive("Purchases")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" rx="1" />
                        <rect x="14" y="3" width="7" height="7" rx="1" />
                        <rect x="3" y="14" width="7" height="7" rx="1" />
                        <rect x="14" y="14" width="7" height="7" rx="1" />
                    </svg>
                    My Purchase
                </a>
                <a asp-controller="Account" asp-action="Wishlist"
                       class="account-nav-item @AccountActive("Wishlist")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                    </svg>
                    Wishlist
                </a>
                <a asp-controller="Account" asp-action="Messages"
                       class="account-nav-item @AccountActive("Messages")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                    Messages
                </a>
                <a asp-controller="Account" asp-action="Cart"
                       class="account-nav-item @AccountActive("Cart")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <path d="M16 10a4 4 0 0 1-8 0" />
                    </svg>
                    My Cart
                    <span class="account-nav-badge cart-count-badge">0</span>
                </a>
            </nav>

            <div class="account-sidebar-divider"></div>

            <a asp-controller="Account" asp-action="Logout" class="account-nav-logout">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Logout
            </a>

            <div class="account-sidebar-deco">
                <img src="~/images/sidebar-plants.png" alt="" onerror="this.style.display='none';" />
            </div>

        </aside>

        @* ── RIGHT SIDE: topbar on top, content below (same as store layout) ── *@
        <div class="account-right">

            <header class="account-topbar">

                <div class="account-topbar-search">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    <input type="text" placeholder="Search for plants, pots, or care accessories..." />
                </div>

                <div class="account-topbar-actions">

                    <a asp-controller="Account" asp-action="Wishlist" class="topbar-action-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                        </svg>
                        Wishlist
                        <span class="topbar-action-badge">3</span>
                    </a>

                    <a asp-controller="Account" asp-action="Cart" class="topbar-action-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="9" cy="21" r="1" />
                            <circle cx="20" cy="21" r="1" />
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                        </svg>
                        Cart
                        <span class="topbar-action-badge cart-count-badge">0</span>
                    </a>

                    <div class="topbar-user-menu" id="topbarUserMenu">
                        <button class="topbar-user-btn" id="topbarUserBtn">
                            <div class="topbar-user-avatar">
                                @if (!string.IsNullOrEmpty(profilePhoto))
                                {
                                    <img src="@profilePhoto" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" alt="avatar" />
                                }
                                else
                                {
                                    <img src="~/images/avatar-placeholder.png" alt="Avatar"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                    <span class="topbar-avatar-fallback" style="display:none;">@initials</span>
                                }
                            </div>
                            <span class="topbar-user-name">Hello, @firstName!</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="topbar-chevron">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </button>

                        <div class="topbar-user-dropdown" id="topbarUserDropdown">
                            <div class="topbar-dropdown-header">
                                <div class="topbar-dropdown-avatar">@initials</div>
                                <div>
                                    <div class="topbar-dropdown-name">@userName</div>
                                    <div class="topbar-dropdown-email">@userEmail</div>
                                </div>
                            </div>
                            <div class="topbar-dropdown-divider"></div>
                            <div class="topbar-dropdown-menu">
                                <a asp-controller="Account" asp-action="Profile" class="topbar-dropdown-item @AccountActive("Profile")">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                        <circle cx="12" cy="7" r="4" />
                                    </svg>
                                    My Profile
                                </a>
                                <a asp-controller="Account" asp-action="Purchases" class="topbar-dropdown-item @AccountActive("Purchases")">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="7" height="7" rx="1" />
                                        <rect x="14" y="3" width="7" height="7" rx="1" />
                                        <rect x="3" y="14" width="7" height="7" rx="1" />
                                        <rect x="14" y="14" width="7" height="7" rx="1" />
                                    </svg>
                                    My Purchase
                                </a>
                                <a asp-controller="Account" asp-action="Wishlist" class="topbar-dropdown-item @AccountActive("Wishlist")">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                    </svg>
                                    Wishlist
                                </a>
                                <a asp-controller="Account" asp-action="Messages" class="topbar-dropdown-item @AccountActive("Messages")">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                    </svg>
                                    Messages
                                </a>
                                <a asp-controller="Account" asp-action="Cart" class="topbar-dropdown-item @AccountActive("Cart")">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                                        <line x1="3" y1="6" x2="21" y2="6" />
                                        <path d="M16 10a4 4 0 0 1-8 0" />
                                    </svg>
                                    My Cart
                                    <span class="topbar-dropdown-badge cart-count-badge">0</span>
                                </a>
                            </div>
                            <div class="topbar-dropdown-divider"></div>
                            <div class="topbar-dropdown-footer">
                                <a asp-controller="Account" asp-action="Logout" class="topbar-dropdown-logout">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                        <polyline points="16 17 21 12 16 7" />
                                        <line x1="21" y1="12" x2="9" y2="12" />
                                    </svg>
                                    Logout
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </header>

            <main class="account-main">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            const topbarUserBtn = document.getElementById('topbarUserBtn');
            const topbarUserMenu = document.getElementById('topbarUserMenu');

            if (topbarUserBtn) {
                topbarUserBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    topbarUserMenu.classList.toggle('open');
                });
            }

            document.addEventListener('click', function(e) {
                if (topbarUserMenu && !topbarUserMenu.contains(e.target)) {
                    topbarUserMenu.classList.remove('open');
                }
            });

                        (function () {
                fetch('/Account/GetCartCount')
                    .then(r => r.json())
                    .then(data => {
                        document.querySelectorAll('.cart-count-badge').forEach(el => {
                            el.textContent = data.count;
                            el.style.display = data.count > 0 ? 'inline-flex' : 'none';
                        });
                    })
                    .catch(() => {});
            })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
