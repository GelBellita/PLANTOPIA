@model Plantopia.Models.LoginModel

@{
    ViewData["Title"] = "Login";
}

<section class="auth-page">
    <div class="auth-card">

        <h2 class="auth-title">Welcome Back</h2>
        <p class="auth-subtitle">Login to shop local Cebuano plants</p>

        <!-- for wrong credentials 67 -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small text-start"></div>

        <form asp-controller="Auth" asp-action="Login" method="post">

            <div class="mb-1 text-start">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <div class="input-icon-wrap">
                    <span class="input-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </span>
                    <input asp-for="Email" class="form-control plant-input plant-input-icon"
                           placeholder="hello@plantopia.ph" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-2 text-start">
                <label asp-for="Password" class="form-label fw-semibold"></label>
                <div class="input-icon-wrap">
                    <span class="input-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </span>
                    <input asp-for="Password" type="password" class="form-control plant-input plant-input-icon"
                           placeholder="Enter your password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
                <div class="text-end mt-1">
                    <a href="#" style="font-size:0.76rem; color:var(--text-muted);">Forgot password?</a>
                </div>
            </div>

            <button type="submit" class="btn btn-plant w-100">Login</button>
        </form>

        <p class="auth-switch mt-4">
            Don't have an account?
            <a asp-controller="Auth" asp-action="Register">Register here</a>
        </p>
    </div>
</section>