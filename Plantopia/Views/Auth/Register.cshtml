@model Plantopia.Models.RegisterModel

@{
    ViewData["Title"] = "Register";
}

<section class="auth-page">
    <div class="auth-card">

        <a class="auth-logo" asp-controller="Home" asp-action="Index">🌿 Plantopia</a>
        <h2 class="auth-title">Create Account</h2>
        <p class="auth-subtitle">Join the Plantopia community 🌱</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small text-start"></div>

        <form asp-controller="Auth" asp-action="Register" method="post">

            <div class="mb-3 text-start">
                <label asp-for="FullName" class="form-label fw-semibold"></label>
                <input asp-for="FullName" class="form-control plant-input" placeholder="Juan dela Cruz" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3 text-start">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control plant-input" placeholder="hello@plantopia.ph" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3 text-start">
                <label asp-for="Password" class="form-label fw-semibold"></label>
                <input asp-for="Password" class="form-control plant-input" placeholder="At least 6 characters" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 text-start">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                <input asp-for="ConfirmPassword" class="form-control plant-input" placeholder="Re-enter your password" />

                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-plant w-100">Create Account</button>
        </form>

        <p class="auth-switch mt-3">
            Already have an account?
            <a asp-controller="Auth" asp-action="Login">Log in here</a>
        </p>
    </div>
</section>