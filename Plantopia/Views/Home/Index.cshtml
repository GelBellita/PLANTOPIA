@model List<Plantopia.Models.Plant>

@{
    ViewData["Title"] = "Home";
    var activeCategory = ViewData["ActiveCategory"]?.ToString() ?? "Indoor Plants";
}
    

<section id="hero">
    <div class="container">
        <div class="row align-items-center" style="min-height: calc(100vh - var(--nav-h));">
            <div class="col-lg-6 col-md-6 d-flex flex-column justify-content-center" style="padding-left: 60px;">

                <h1 class="hero-title">
                    Plants Gonna Make
                    <em>People Happy</em>
                </h1>
                <a href="c:\users\april\desktop\plantopia\plantopia\views\home\index.cshtml"></a>
                <p class="hero-sub">
                    Let's bring a new friend home. Proudly sourced from
                    local Cebuano plant growers — homegrown, heart-grown,
                    Cebu-grown.
                </p>

                <div class="d-flex gap-3 flex-wrap">
                    <a class="btn btn-plant" href="#collection">Shop Plants</a>
                    <a class="btn btn-outline-plant" href="#about">Our Story</a>
                </div>

            </div>
            <div class="col-lg-6 col-md-6 d-flex flex-column justify-content-center ps-5">
                <img src="/images/plant.png"
                     alt="Plantopia"
                     style="height: 400px; width: auto; object-fit: contain; margin-left: 60px;" />
            </div>
        </div>
    </div>
</section>

<section id="collection">
    <div class="container">

        <span class="section-tag text-center d-block">BROWSE COLLECTION</span>
        <h2 class="section-title text-center mb-4">Shop By Category</h2>

        <div class="d-flex justify-content-center flex-wrap gap-2 mb-5">
            <a class="category-tab @(activeCategory == "Indoor Plants" ? "active" : "")"
               asp-controller="Home" asp-action="Index"
               asp-route-category="Indoor Plants">Indoor Plants</a>

            <a class="category-tab @(activeCategory == "Outdoor Plants" ? "active" : "")"
               asp-controller="Home" asp-action="Index"
               asp-route-category="Outdoor Plants">Outdoor Plants</a>

            <a class="category-tab @(activeCategory == "Succulents" ? "active" : "")"
               asp-controller="Home" asp-action="Index"
               asp-route-category="Succulents">Succulents</a>

            <a class="category-tab @(activeCategory == "Hanging Plants" ? "active" : "")"
               asp-controller="Home" asp-action="Index"
               asp-route-category="Hanging Plants">Hanging Plants</a>
        </div>

        <div class="row g-4">
            @if (Model.Count == 0)
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">No plants available in this category yet. Check back soon! 🌱</p>
                </div>
            }
            else
            {
                @foreach (var plant in Model)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="plant-card h-100">

                            @if (!string.IsNullOrEmpty(plant.Badge))
                            {
                                <span class="plant-badge @(plant.Badge == "Hot" ? "badge-hot" : "badge-new")">
                                    @plant.Badge
                                </span>
                            }

                            <a asp-controller="Shop" asp-action="Register" asp-route-id="@plant.Id">
                                @if (!string.IsNullOrEmpty(plant.ImageUrl))
                                {
                                    <img src="@plant.ImageUrl" alt="@plant.Name" class="plant-img" />
                                }
                                else
                                {
                                    <div class="plant-placeholder">@plant.Name</div>
                                }
                            </a>

                            <div class="plant-info">
                                <h5 class="plant-name">
                                    <a asp-controller="Shop" asp-action="Detail" asp-route-id="@plant.Id">
                                        @plant.Name
                                    </a>
                                </h5>
                                <div class="plant-stars">★★★★★</div>
                                <div class="plant-price-row">
                                    @if (!string.IsNullOrEmpty(plant.Badge))
                                    {
                                        <span class="price-original">₱@((plant.Price * 1.14m).ToString("0"))</span>
                                    }
                                    <span class="plant-price">₱@plant.Price.ToString("0.00")</span>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }
        </div>

    </div>
</section>

<section id="about">
    <div class="about-overlay">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 col-md-10">

                    <div class="story-card">
                        <span class="section-tag-dark">Our Story · Ang Among Istorya</span>

                        <h2 class="story-title">
                            Dili ka mag-inusara —
                            <em>Plantopia is here.</em>
                        </h2>

                        <p class="story-body">
                            Dili ka mag-inusara sa imong balay — Plantopia has the perfect
                            green companion para sa'yo! Proudly sourced from our local Cebuano
                            plant growers or sellers, every plant you bring home is more than
                            just décor — it's a pag-ampo sa atong mga kababayan who pour their
                            love and hardwork into every leaf and stem.
                        </p>

                        <p class="story-body">
                            Laban lang, mga local farmers! 🧑‍🌾 When you choose Plantopia,
                            you're not just greening up your space — you're supporting Cebuano
                            lives, Cebuano hands, and Cebuano hearts. Panahon na para
                            mag-invest sa natural beauty —
                            <strong>homegrown, heart-grown, Cebu-grown.</strong> 🌿
                        </p>

                        <p class="story-body">
                            Shop local. Grow happy. Every plant at Plantopia comes straight
                            from Cebuano hands to your home.
                        </p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<section id="sellers">
    <div class="container">

        <span class="section-tag text-center d-block">MEET OUR SELLERS</span>
        <h2 class="section-title text-center mb-5">The People Behind Every Plant</h2>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="seller-card" style="background-image: linear-gradient(to top, rgba(10,30,10,0.85) 40%, transparent 100%), url('/images/farmers/farmer-dante.png');">
                    <div class="seller-info">
                        <h4>Kuya Dante</h4>
                        <p class="seller-role">Succulent Specialist · Talamban, Cebu</p>
                        <p class="seller-quote">"Every plant I grow is a piece of my heart sa atong Sugbo."</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="seller-card" style="background-image: linear-gradient(to top, rgba(10,30,10,0.85) 40%, transparent 100%), url('/images/farmers/farmer-cris.jpg');">
                    <div class="seller-info">
                        <h4>Ate Cris</h4>
                        <p class="seller-role">Vine &amp; Fern Expert · Consolacion, Cebu</p>
                        <p class="seller-quote">"Ang akong mga tanom mao ang akong kinabuhi ug gugma."</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="seller-card" style="background-image: linear-gradient(to top, rgba(10,30,10,0.85) 40%, transparent 100%), url('/images/farmers/farmer-tomas.jpg');">
                    <div class="seller-info">
                        <h4>Lolo Tomas</h4>
                        <p class="seller-role">Master Grower · Liloan, Cebu</p>
                        <p class="seller-quote">"40 years of nurturing — each plant tells a story of Cebu."</p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<footer class="plant-footer" id="footer">
    <div class="container">
        <div class="row g-4 align-items-start">

            <div class="col-lg-4 col-md-12 mb-2">
                <div class="footer-brand">
                    <span class="footer-brand-name">🌿 Plantopia</span>
                    <p class="footer-tagline">
                        Homegrown, heart-grown, Cebu-grown.<br />
                        Supporting local farmers, one plant at a time. 🇵🇭
                    </p>
                    <div class="footer-socials">
                        <a href="#" class="footer-social-btn" aria-label="Facebook">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                            </svg>
                        </a>
                        <a href="#" class="footer-social-btn" aria-label="Instagram">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                                <circle cx="12" cy="12" r="4" />
                                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                            </svg>
                        </a>
                        <a href="#" class="footer-social-btn" aria-label="X / Twitter">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622Zm-1.161 17.52h1.833L7.084 4.126H5.117Z" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <h6 class="footer-heading">SHOP</h6>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index" asp-route-category="Indoor Plants">Indoor Plants</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-route-category="Outdoor Plants">Outdoor Plants</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-route-category="Succulents">Succulent</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-route-category="Hanging Plants">Hanging</a></li>
                </ul>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <h6 class="footer-heading">COMPANY</h6>
                <ul class="footer-links">
                    <li><a href="#about">About Us</a></li>
                    <li><a href="#sellers">Our Farmers</a></li>
                    <li><a href="#">Blog</a></li>
                    <li><a href="#">Careers</a></li>
                </ul>
            </div>

            <div class="col-lg-4 col-md-6">
                <h6 class="footer-heading">STAY IN THE LOOP</h6>
                <p class="footer-newsletter-text">Get plant care tips & new arrivals straight to your inbox.</p>
                <div class="footer-newsletter">
                    <input type="email" class="footer-newsletter-input" placeholder="plantopia@gmail.com" />
                    <button class="footer-newsletter-btn">→</button>
                </div>
                <ul class="footer-links mt-3">
                    <li>📍 Cebu City, PH</li>
                    <li>📞 09487405442</li>
                    <li>✉️ plantopia@gmail.com</li>
                </ul>
            </div>

        </div>

        <div class="footer-bottom">
            <p>© @DateTime.Now.Year Plantopia. All rights reserved. Made with 💚 in Cebu.</p>
            <p>Privacy Policy · Terms of Use</p>
        </div>
    </div>
</footer>
<!-- Auth Gate Modal -->
<div class="modal fade" id="authGateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content auth-modal" style="background-image: url('/images/background/Auth_Gate.png'); background-size: cover; background-position: center;">
            <div class="modal-body text-center p-5">
                <img src="/images/SMALL_LOGO.png" alt="Plantopia" style="height: 60px; width: auto; margin-bottom: 12px;" />
                <h4 class="auth-modal-title">Join Plantopia First!</h4>
                <p class="auth-modal-sub">Create an account or log in to continue shopping.</p>
                <div class="d-flex gap-3 justify-content-center mt-4">
                    <a id="authGateRegister" href="/Auth/Register" class="btn btn-plant">Register</a>
                    <a id="authGateLogin" href="/Auth/Login" class="btn btn-outline-plant">Log In</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/plantopia.js" asp-append-version="true"></script>
}
